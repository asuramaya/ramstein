#!/usr/bin/env python3
"""ramsteind — the memory demon: owns the truth about bytes alive.

Polls /proc/meminfo and /proc/pressure/memory every tick, computes an
EWMA burn rate of available-memory consumption and an ETA-to-OOM under
current pressure, and publishes status.json for the CLI and the GNOME
pill. The daemon is the only privileged actor; the CLI and pill only
read status and poke the control socket.

stdlib only, by constitution.
"""

import argparse
import json
import os
import signal
import sqlite3
import subprocess
import threading
import time

# --- sutra bootstrap (sutra 0.11.1; see docs/BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "ramstein"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra

# One version constant, packaging/VERSION; nothing here duplicates it as a
# literal. A hardcoded copy drifted once already (0.6.1's footer stayed on
# 0.6.0 after a daemon-touching release), so the daemon reads the same
# installed-path candidates ramstein-update already searches for its own
# version lookup, rather than a second source of truth someone has to
# remember to bump by hand. This file lives at src/bin/ramsteind, two levels
# under the repo root, so _SRC_DIR needs three dirname calls, not two — a
# level got added when bin/ moved under src/ (REPO-STANDARD.md's tree pass);
# getting this wrong silently swallows the repo-relative fallback instead of
# raising, which is exactly why it is spelled out here instead of just
# written and trusted.
_SRC_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
VERSION_CANDIDATES = (
    "/usr/share/ramstein/VERSION",
    "/usr/local/share/ramstein/VERSION",
    os.path.join(_SRC_DIR, "packaging", "VERSION"),
)


def _read_version():
    for path in VERSION_CANDIDATES:
        try:
            with open(path) as f:
                v = f.read().strip()
        except OSError:
            continue
        if v:
            return v
    return "unknown"


VERSION = _read_version()

RUNTIME_DIR = os.environ.get("RAMSTEIN_RUNTIME_DIR", "/run/ramstein")
STATUS_PATH = os.path.join(RUNTIME_DIR, "status.json")
SOCKET_PATH = os.path.join(RUNTIME_DIR, "control.sock")

# Config is the seed, never the master: it can tune numbers within clamps,
# but it cannot grant anything the daemon doesn't already do. Unknown keys
# are ignored, bad types fall back to defaults.
DEFAULTS = {
    "poll_interval": 10,       # memory moves faster than disk
    "burn_tau": 120,           # EWMA time constant for burn rate (s)
    "eta_cap_hours": 24.0,     # ETAs beyond this are noise -> omitted
    "warn_psi_some": 10.0,     # PSI some avg10 above this -> warn
    "warn_avail_pct": 15.0,
    "warn_eta_hours": 4.0,
    "hot_psi_full": 5.0,       # PSI full avg10 above this -> hot
    "hot_avail_pct": 5.0,
    "hot_eta_minutes": 30.0,
    "owner_uid": 1000,         # status/socket are chowned here when root
    "sample_every": 3,         # sampler runs every Nth poll (M2 index)
    "proc_min_bytes": 16 * 1024 * 1024,  # rss+swap floor to earn an index row
    "recent_ring": 120,        # fine-grained samples kept (~1h at defaults)
    "hourly_ring": 168,        # promoted samples kept (~7d)
    "advise_growth_mib_per_hour": 500.0,  # advise rule 2's leak-ish threshold
    "swap_storm_eta_minutes": 10.0,   # V2.M1: combined ETA below this + swap
                                       # actively growing -> warning:swap_storm
    "swap_storm_hysteresis_polls": 3,  # consecutive clear polls before it drops
    "zombie_advise_min": 3,    # V2.M1: a parent needs this many unreaped
                               # children before advise names it — a lone
                               # stray zombie about to be reaped is noise
    "advise_shmem_pct": 15.0,  # Shmem (tmpfs/dev/shm/SysV+POSIX shm, machine-
                               # wide per /proc/meminfo — NOT scoped to /tmp
                               # alone, see the shmem advise rule) above this
                               # % of total RAM is worth naming: correctly
                               # excluded from MemAvailable, so it never shows
                               # up as "the problem" anywhere else on the card
    # V2.M2: auto-calm — the master switch. Even fully armed (see
    # auto_calm_armed below) and even with the opt-in systemd timer
    # enabled, a cycle does nothing unless this is also true. Kill is
    # never in scope, at any setting — see do_autocalm_run.
    "auto_calm_enabled": False,
    # Config-persisted, not runtime-only: `ramstein autocalm arm`/`dry`
    # write this back to config.json (see _persist_auto_calm_armed) AND
    # flip the daemon's live autocalm_state in the same act, so a restart
    # inherits the operator's last choice instead of amnesia-ing back to
    # dry-run every time. Was in-memory-only through 0.11.1 (alfred's
    # design-brief arc, DM #3074/#3079/#3080): that shape modeled itself on
    # the kill gate's fresh-confirmation-every-time discipline, which is
    # right for kill (irreversible) and wrong here — renice and memory.high
    # squeeze are both mild and reversible (do_calm's --release un-does the
    # squeeze), so consent that expires is a correction away from being
    # right, not a weakening to remove it. The TTY confirmation on the
    # FIRST `arm` stays exactly as strict as before; only the "forgets on
    # every restart" part was the bug.
    "auto_calm_armed": False,
    "auto_calm_psi_some": 20.0,   # a HIGHER bar than warn_psi_some (10.0) —
                                   # taking action earns a stricter threshold
                                   # than just lighting the pill WARN
    "auto_calm_psi_full": 10.0,
    "auto_calm_use_swap_storm": True,  # an active M1 warning also triggers
    "auto_calm_step_renice": True,
    "auto_calm_step_squeeze": True,
    "auto_calm_nice": 15,
    # memory.high -> this % of the target's CURRENT rss. do_calm's own
    # floor (docs/ARCHITECTURE.md, "The hands") never lets memory.high below 110% of
    # rss regardless of what's requested — so this must be >= that floor
    # or the request is silently a no-op, always overridden upward. 130%
    # gives the target a little headroom to keep running while capping how
    # much FURTHER it can grow before the kernel starts pushing back.
    "auto_calm_squeeze_pct": 130.0,
    "auto_calm_cooldown_seconds": 300.0,  # min gap between acted-on cycles
    "swap_size_min_disk_headroom_gb": 10.0,  # swap-size set refuses a resize
                                       # that would leave less than this free
                                       # on the backing filesystem afterward —
                                       # an oversized swap file trading a RAM
                                       # crisis for a disk crisis is exactly
                                       # what this exists to block
}

CLAMPS = {
    "poll_interval": (1, 3600),
    "burn_tau": (5, 86400),
    "eta_cap_hours": (0.1, 8760),
    "warn_psi_some": (0.0, 100.0),
    "warn_avail_pct": (0.0, 100.0),
    "warn_eta_hours": (0.01, 8760),
    "hot_psi_full": (0.0, 100.0),
    "hot_avail_pct": (0.0, 100.0),
    "hot_eta_minutes": (0.1, 525600),
    "owner_uid": (0, 2 ** 31),
    "sample_every": (1, 360),
    "proc_min_bytes": (1 << 20, 1 << 40),
    "recent_ring": (2, 100000),
    "hourly_ring": (2, 100000),
    "advise_growth_mib_per_hour": (1.0, 1000000.0),
    "swap_storm_eta_minutes": (0.1, 1440.0),
    "swap_storm_hysteresis_polls": (1, 60),
    "zombie_advise_min": (1, 100000),
    "advise_shmem_pct": (0.0, 100.0),
    "auto_calm_psi_some": (0.0, 100.0),
    "auto_calm_psi_full": (0.0, 100.0),
    "auto_calm_nice": (0, 19),         # NICE_MIN/NICE_MAX — calm only lowers
    # floor matches do_calm's own hardcoded 1.1x-rss floor (docs/ARCHITECTURE.md,
    # "The hands"): anything below 110% would be silently overridden
    # upward by do_calm itself, every time, so the clamp says so honestly
    # rather than accepting a value that can never take effect
    "auto_calm_squeeze_pct": (110.0, 500.0),
    "auto_calm_cooldown_seconds": (30.0, 86400.0),
    "swap_size_min_disk_headroom_gb": (0.1, 100000.0),
}


def load_config(path):
    return sutra.load_config(path, DEFAULTS, CLAMPS)


# --- polling ----------------------------------------------------------------

MEMINFO_KEYS = ("MemTotal", "MemAvailable", "SwapTotal", "SwapFree", "Shmem")
PSI_KEYS = ("some_avg10", "some_avg60", "some_avg300",
            "full_avg10", "full_avg60", "full_avg300")


def read_meminfo():
    vals = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            if key in MEMINFO_KEYS:
                vals[key] = int(rest.split()[0]) * 1024  # kB -> bytes
    return vals


def read_psi():
    psi = {k: None for k in PSI_KEYS}
    try:
        with open("/proc/pressure/memory") as f:
            lines = f.read().splitlines()
    except OSError:
        return psi  # no CONFIG_PSI — classify on meminfo alone
    for line in lines:
        parts = line.split()
        if not parts or parts[0] not in ("some", "full"):
            continue
        fields = dict(p.split("=", 1) for p in parts[1:] if "=" in p)
        for avg in ("avg10", "avg60", "avg300"):
            if avg in fields:
                try:
                    psi[f"{parts[0]}_{avg}"] = float(fields[avg])
                except ValueError:
                    pass
    return psi


def poll_memory(state, cfg, now):
    mi = read_meminfo()
    total = mi.get("MemTotal", 0)
    avail = mi.get("MemAvailable", 0)
    swap_total = mi.get("SwapTotal", 0)
    swap_free = mi.get("SwapFree", 0)
    shmem = mi.get("Shmem", 0)
    psi = read_psi()

    prev = state.get("mem")
    # sutra.ewma_rate wants the quantity whose INCREASE is the burn; RAMstein
    # measures consumption, so feed it the used-equivalent (total - avail) —
    # since total is constant, avail falling and used rising are the same
    # rate, just mirrored. burn stays positive-when-memory-is-eaten.
    state["mem"], ewma = sutra.ewma_rate(prev, total - avail, now,
                                         cfg["burn_tau"])

    eta = None
    if ewma > 1024.0:  # below 1 KiB/s the ETA is astrology
        eta = (avail + swap_free) / ewma
        if eta > cfg["eta_cap_hours"] * 3600:
            eta = None

    state, evidence = classify(total, avail, psi, eta, cfg)
    return {
        "total": total,
        "available": avail,
        "swap_total": swap_total,
        "swap_free": swap_free,
        "shmem": shmem,
        "psi": psi,
        "burn_bps": round(ewma, 1),
        "eta_oom_seconds": None if eta is None else int(eta),
        "state": state,
        "state_evidence": evidence,
    }


def classify(total, avail, psi, eta, cfg):
    """Returns (state, evidence) -- `state` stays the same bare
    "ok"|"warn"|"hot" string every existing caller (the CLI's FLAGS lookup,
    smoke.sh) already keys on, but each level ORs 2-3 independent
    conditions and previously discarded WHICH of them actually fired.
    FAMILY.md ("Headers state STATE, not a number"): "warn" from stalling
    tasks (psi) and "warn" from a three-hour ETA are different situations
    needing different responses, and a header that only shows the level
    can't tell them apart. `evidence` is the list of condition codes that
    fired at the returned level -- "psi" (full10 for hot, some10 for
    warn), "avail" (available % below the level's floor), "eta" (ETA
    under the level's horizon) -- never collapsed into the bare string."""
    pct = 100.0 * avail / total if total else 0.0
    full10, some10 = psi["full_avg10"], psi["some_avg10"]

    hot = []
    if full10 is not None and full10 > cfg["hot_psi_full"]:
        hot.append("psi")
    if pct < cfg["hot_avail_pct"]:
        hot.append("avail")
    if eta is not None and eta < cfg["hot_eta_minutes"] * 60:
        hot.append("eta")
    if hot:
        return "hot", hot

    warn = []
    if some10 is not None and some10 > cfg["warn_psi_some"]:
        warn.append("psi")
    if pct < cfg["warn_avail_pct"]:
        warn.append("avail")
    if eta is not None and eta < cfg["warn_eta_hours"] * 3600:
        warn.append("eta")
    if warn:
        return "warn", warn

    return "ok", []


def write_status(doc, cfg):
    sutra.write_status(STATUS_PATH, doc, owner=(cfg["owner_uid"], -1))


# --- V2.M1: the watchman — swap-storm early warning -------------------------
# A second EWMA, this one over swap consumption specifically. The general
# classifier (avail%/PSI/eta) can stay "ok" for a while even as swap visibly
# drains, since MemAvailable is a reclaimable-cache-aware kernel heuristic
# that doesn't move in lockstep with swap — this is the signal that catches
# THAT gap. Sticky with hysteresis (a counter of consecutive clear polls,
# not just a single below-threshold reading) so it doesn't flap on a value
# hovering right at the horizon.

def poll_swap_storm(state, cfg, now, swap_total, swap_free, eta_oom_seconds):
    prev = state.get("swap")
    state["swap"], swap_ewma = sutra.ewma_rate(
        prev, swap_total - swap_free, now, cfg["burn_tau"])

    horizon = cfg["swap_storm_eta_minutes"] * 60
    triggered = (swap_ewma > 1024.0 and eta_oom_seconds is not None
                 and eta_oom_seconds < horizon)

    active = state.get("swap_storm_active", False)
    clear_count = state.get("swap_storm_clear_count", 0)
    if triggered:
        active, clear_count = True, 0
    elif active:
        clear_count += 1
        if clear_count >= cfg["swap_storm_hysteresis_polls"]:
            active, clear_count = False, 0
    state["swap_storm_active"] = active
    state["swap_storm_clear_count"] = clear_count

    if not active:
        return None
    return {
        "kind": "swap_storm",
        "eta_oom_seconds": eta_oom_seconds,
        "swap_burn_bps": round(swap_ewma, 1),
        "top_growers": _top_swap_growers(3),
    }


def _top_swap_growers(limit):
    """Top swap-delta growers over a recent window — a storm is about
    GROWTH, not standing swap usage, so this diffs two samples the same way
    advise's growth rule (rule 2) does, rather than just ranking current
    VmSwap. Needs the index; returns [] before the sampler's first sample or
    once span is too thin to trust (< 5 min, same floor as rule 2)."""
    con = _connect_index()
    try:
        head = _latest_sample(con)
        if head is None:
            return []
        head_id, head_ts = head
        base = con.execute(
            "SELECT id, ts FROM samples WHERE ts <= ?"
            " ORDER BY ts DESC LIMIT 1", (head_ts - 300,)).fetchone()
        if base is None:
            base = con.execute(
                "SELECT id, ts FROM samples ORDER BY ts ASC LIMIT 1").fetchone()
        if base is None or base[0] == head_id or head_ts - base[1] < 300:
            return []
        base_id, _base_ts = base
        # SQLite's WHERE can't see a SELECT-list alias (delta), so the
        # positive-growth filter runs client-side after the fetch instead
        rows = con.execute(
            "SELECT h.pid, h.comm, h.swap - COALESCE(b.swap, 0) AS delta"
            " FROM proc_stats h LEFT JOIN proc_stats b"
            "   ON b.sample_id=? AND b.pid=h.pid AND b.starttime=h.starttime"
            " WHERE h.sample_id=? AND h.swap > 0"
            " ORDER BY delta DESC LIMIT ?",
            (base_id, head_id, limit * 4)).fetchall()
        return [{"pid": r[0], "comm": r[1], "swap_delta": r[2]}
                for r in rows if r[2] > 0][:limit]
    finally:
        con.close()


# --- index: the persistent truth about who's holding memory hostage --------
# One tick is one sample: pid/comm/VmRSS/VmSwap/state/ppid for every process
# at or above proc_min_bytes, keyed by (pid, starttime) — starttime (stat
# field 22) disambiguates pid reuse, the swap analogue of byebyte's path
# interning. Two rings share one promoted flag: recent_ring keeps every
# sample (~1h fine-grained), hourly_ring keeps one promoted sample per hour
# (~7d coarse) — `top`/`swap` read the latest sample, `blame` diffs two.
# The sampler runs synchronously in the poll loop (a /proc pass is cheap,
# unlike byebyte's disk walk, so it never needs its own thread); every query
# opens its own short-lived read connection, so a `top` never blocks a tick.

STATE_DIR = os.environ.get("RAMSTEIN_STATE_DIR", "/var/lib/ramstein")
DB_PATH = os.path.join(STATE_DIR, "index.db")

_SCHEMA = """
CREATE TABLE IF NOT EXISTS samples(
    id INTEGER PRIMARY KEY,
    ts REAL NOT NULL,
    promoted INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS proc_stats(
    sample_id INTEGER NOT NULL,
    pid INTEGER NOT NULL,
    starttime INTEGER NOT NULL,
    comm TEXT NOT NULL,
    rss INTEGER NOT NULL,
    swap INTEGER NOT NULL,
    state TEXT NOT NULL,
    ppid INTEGER NOT NULL,
    PRIMARY KEY(sample_id, pid, starttime)) WITHOUT ROWID;
"""


def _connect_index():
    os.makedirs(STATE_DIR, exist_ok=True)
    con = sqlite3.connect(DB_PATH, timeout=30)
    con.execute("PRAGMA journal_mode=WAL")
    return con


def _read_procs():
    """One pass over /proc: pid/comm/rss/swap/state/ppid/starttime for every
    process with a VmRSS line. Kernel threads (no VmRSS — no memory mappings)
    and unreadable pids (other users, or a pid that exited mid-scan) are
    skipped silently; as root this sees all."""
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            with open(f"/proc/{pid}/status") as f:
                status = f.read()
        except OSError:
            continue
        if "VmRSS" not in status:
            continue  # kernel thread
        comm = state = None
        ppid = rss = swap = 0
        for line in status.splitlines():
            key, _, rest = line.partition(":")
            if key == "Name":
                comm = rest.strip()
            elif key == "State":
                state = rest.strip().split()[0]
            elif key == "PPid":
                ppid = int(rest.strip())
            elif key == "VmRSS":
                rss = int(rest.split()[0]) * 1024
            elif key == "VmSwap":
                swap = int(rest.split()[0]) * 1024
        try:
            with open(f"/proc/{pid}/stat") as f:
                stat = f.read()
        except OSError:
            continue
        # comm is parenthesized and may itself contain ')' or spaces; split
        # on the LAST ')' so the fixed-format fields after it stay aligned.
        # what follows is field 3 (state) onward, so field 22 (starttime,
        # 1-indexed) sits at offset 22-3=19 in the split remainder.
        rest_fields = stat[stat.rfind(")") + 2:].split()
        try:
            starttime = int(rest_fields[19])
        except (IndexError, ValueError):
            continue
        yield {"pid": pid, "comm": comm or "?", "rss": rss, "swap": swap,
               "state": state or "?", "ppid": ppid, "starttime": starttime}


class Sampler:
    def __init__(self, cfg):
        self.cfg = cfg
        self._tick = 0
        self._last_promoted_ts = None
        self.last_sample_ts = None
        con = _connect_index()
        try:
            con.executescript(_SCHEMA)
            con.commit()
        finally:
            con.close()

    def maybe_sample(self, now):
        self._tick += 1
        if self._tick % self.cfg["sample_every"]:
            return False
        self._sample(now)
        return True

    def _sample(self, now):
        floor = self.cfg["proc_min_bytes"]
        procs = [p for p in _read_procs() if p["rss"] + p["swap"] >= floor]
        promote = (self._last_promoted_ts is None
                   or now - self._last_promoted_ts >= 3600)
        con = _connect_index()
        try:
            cur = con.execute(
                "INSERT INTO samples(ts, promoted) VALUES(?,?)",
                (now, int(promote)))
            sid = cur.lastrowid
            con.executemany(
                "INSERT INTO proc_stats VALUES(?,?,?,?,?,?,?,?)",
                [(sid, p["pid"], p["starttime"], p["comm"], p["rss"],
                  p["swap"], p["state"], p["ppid"]) for p in procs])
            self._prune(con)
            con.commit()
        finally:
            con.close()
        if promote:
            self._last_promoted_ts = now
        self.last_sample_ts = now

    def _prune(self, con):
        keep = {r[0] for r in con.execute(
            "SELECT id FROM samples ORDER BY ts DESC LIMIT ?",
            (self.cfg["recent_ring"],))}
        keep |= {r[0] for r in con.execute(
            "SELECT id FROM samples WHERE promoted=1 ORDER BY ts DESC LIMIT ?",
            (self.cfg["hourly_ring"],))}
        stale = [r[0] for r in con.execute("SELECT id FROM samples")
                 if r[0] not in keep]
        if stale:
            marks = ",".join("?" * len(stale))
            con.execute(f"DELETE FROM proc_stats WHERE sample_id IN ({marks})",
                        stale)
            con.execute(f"DELETE FROM samples WHERE id IN ({marks})", stale)


def _latest_sample(con):
    return con.execute(
        "SELECT id, ts FROM samples ORDER BY ts DESC LIMIT 1").fetchone()


def query_top(by_swap, limit):
    con = _connect_index()
    try:
        latest = _latest_sample(con)
        if latest is None:
            return {"error": "no sample yet — wait for the sampler"}
        sid, ts = latest
        col = "swap" if by_swap else "rss"  # by_swap is a validated bool
        rows = con.execute(
            f"SELECT pid, comm, rss, swap, state FROM proc_stats"
            f" WHERE sample_id=? ORDER BY {col} DESC LIMIT ?", (sid, limit)
        ).fetchall()
        return {"ts": ts, "rows": [
            {"pid": r[0], "comm": r[1], "rss": r[2], "swap": r[3],
             "state": r[4]} for r in rows]}
    finally:
        con.close()


def query_swap(limit):
    con = _connect_index()
    try:
        latest = _latest_sample(con)
        if latest is None:
            return {"error": "no sample yet — wait for the sampler"}
        sid, ts = latest
        rows = con.execute(
            "SELECT pid, comm, rss, swap, state FROM proc_stats"
            " WHERE sample_id=? AND swap > 0 ORDER BY swap DESC LIMIT ?",
            (sid, limit)).fetchall()
        return {"ts": ts, "rows": [
            {"pid": r[0], "comm": r[1], "rss": r[2], "swap": r[3],
             "state": r[4]} for r in rows]}
    finally:
        con.close()


def query_blame(since, limit):
    con = _connect_index()
    try:
        head = _latest_sample(con)
        if head is None:
            return {"error": "no sample yet — wait for the sampler"}
        head_id, head_ts = head
        base = con.execute(
            "SELECT id, ts FROM samples WHERE ts <= ? ORDER BY ts DESC LIMIT 1",
            (since,)).fetchone()
        if base is None:
            # every sample is newer than --since: diff from the oldest one we
            # have and report the honest span, rather than refusing
            base = con.execute(
                "SELECT id, ts FROM samples ORDER BY ts ASC LIMIT 1").fetchone()
        if base is None or base[0] == head_id:
            return {"error": "no earlier sample to diff against"
                             " — need two samples spanning --since"}
        base_id, base_ts = base
        rows = con.execute(
            "SELECT h.pid, h.starttime, h.comm,"
            "       h.rss - COALESCE(b.rss, 0) AS delta, h.rss, h.swap,"
            "       CASE WHEN b.rss IS NULL THEN 1 ELSE 0 END, 0"
            " FROM proc_stats h LEFT JOIN proc_stats b"
            "   ON b.sample_id=? AND b.pid=h.pid AND b.starttime=h.starttime"
            " WHERE h.sample_id=?"
            " UNION ALL "
            "SELECT b.pid, b.starttime, b.comm, -b.rss, 0, 0, 0, 1"
            " FROM proc_stats b WHERE b.sample_id=? AND NOT EXISTS ("
            "   SELECT 1 FROM proc_stats h WHERE h.sample_id=?"
            "     AND h.pid=b.pid AND h.starttime=b.starttime)",
            (base_id, head_id, base_id, head_id)).fetchall()
        rows.sort(key=lambda r: (-abs(r[3]), 0 if r[3] >= 0 else 1))
        rows = rows[:limit]
        return {"base_ts": base_ts, "head_ts": head_ts, "rows": [
            {"pid": r[0], "starttime": r[1], "comm": r[2], "delta": r[3],
             "rss": r[4], "swap": r[5], "new": bool(r[6]), "gone": bool(r[7])}
            for r in rows]}
    finally:
        con.close()


def query_zombies():
    rows = []
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            with open(f"/proc/{pid}/status") as f:
                status = f.read()
        except OSError:
            continue
        comm = state = None
        ppid = 0
        for line in status.splitlines():
            key, _, rest = line.partition(":")
            if key == "Name":
                comm = rest.strip()
            elif key == "State":
                state = rest.strip().split()[0]
            elif key == "PPid":
                ppid = int(rest.strip())
        if state != "Z":
            continue
        parent_comm = "?"
        try:
            with open(f"/proc/{ppid}/status") as f:
                for line in f:
                    if line.startswith("Name:"):
                        parent_comm = line.partition(":")[2].strip()
                        break
        except OSError:
            pass
        rows.append({"pid": pid, "comm": comm or "?", "ppid": ppid,
                     "parent_comm": parent_comm})
    return {"rows": rows}


def _limit(req):
    lim = req.get("limit", 20)
    if not isinstance(lim, int) or not 1 <= lim <= 1000:
        raise ValueError("limit must be an int in 1..1000")
    return lim


# --- hands: calm / oom / advise (M3) ----------------------------------------
# The invariant gates come first, on purpose (docs/ARCHITECTURE.md, "The hands"):
# coexistence with systemd-oomd/earlyoom, and the kill gate. The CLI gates the
# HUMAN (fresh per-invocation TTY confirmation); the daemon gates the SYSCALL
# (re-resolves pid+starttime itself, never trusts that what the CLI resolved
# earlier is still true by the time the command arrives). Ledgered to
# STATE_DIR/ledger.jsonl, the family ledger, memory dialect.

CALM_HIGH_FLOOR_BYTES = 64 * 1024 * 1024  # docs/ARCHITECTURE.md's calm floor
NICE_MIN, NICE_MAX = 0, 19                # calm only ever LOWERS priority
LEDGER_PATH = os.path.join(STATE_DIR, "ledger.jsonl")


_OOMD_SWAP_HEADER = "Swap Monitored CGroups:\n"
_OOMD_PRESSURE_HEADER = "Memory Pressure Monitored CGroups:\n"


def _oomd_monitored_sections():
    """One oomctl call, returns {"swap": bool, "pressure": bool} — whether
    EACH section has at least one enrolled cgroup, bounded on BOTH ends.
    systemd-oomd being active only means the service is running — it
    still needs to be ENROLLED on at least one cgroup (ManagedOOMSwap=kill
    or ManagedOOMMemoryPressure=kill) to actually act on anything. A
    machine can run systemd-oomd at 100% swap, above its own Swap Used
    Limit, watching nothing (confirmed live, 2026-08-02). `oomctl`'s dump
    prints "\tPath: <cgroup>\n" once per enrolled cgroup under each
    "...Monitored CGroups:" header (systemd src/oom/oomd-util.c) and
    nothing when a section's hashmap is empty.

    A PRIOR VERSION anchored only on the START of "Swap Monitored
    CGroups:" and read to EOF — correct for "is ANY oomd enrollment
    present" (_coexisting_oom_fighter's actual question), WRONG once
    reused for "is SWAP specifically enrolled" (the new oomd-enroll
    verb's question): the tail-to-EOF scoop also contains the entire
    Memory Pressure section that follows it, so a pressure-only Path:
    line satisfied a query asking about swap. Found live on the
    operator's own machine (alfred, DM #3250) the same day this verb
    shipped: RAMstein reported swap protection that did not exist — the
    exact failure class this whole night's work exists to catch, one
    layer up, in the tool built to catch it. Fixed by bounding swap's
    tail at the pressure header (which follows it in the dump) instead
    of running to EOF; pressure's own tail is already exact since
    nothing follows IT. One predicate, two ends, both sections in one
    call — no caller may ask a section-blind question again."""
    try:
        r = subprocess.run(["oomctl"], capture_output=True, text=True,
                            timeout=2)
    except (OSError, subprocess.SubprocessError):
        return {"swap": False, "pressure": False}
    if r.returncode != 0:
        return {"swap": False, "pressure": False}
    _, _, after_swap = r.stdout.partition(_OOMD_SWAP_HEADER)
    swap_section = after_swap.split(_OOMD_PRESSURE_HEADER, 1)[0]
    _, _, pressure_section = r.stdout.partition(_OOMD_PRESSURE_HEADER)
    return {"swap": "\tPath: " in swap_section,
            "pressure": "\tPath: " in pressure_section}


def _oomd_swap_enrolled():
    return _oomd_monitored_sections()["swap"]


def _coexist_status():
    """Read-only: is systemd-oomd or earlyoom already fighting OOM here,
    and — for systemd-oomd — exactly which half (swap/pressure). The
    single source of truth for the coexist question: _coexisting_oom_
    fighter() (the broad either-section question the M1 tests already
    exercise) and _coexist_label() (the OR'd-evidence-named wording,
    thread 3dd73060) both read off this instead of re-deriving it or
    re-spawning systemctl/oomctl a second time. earlyoom has no
    enrollment concept of its own — active means watching system-wide
    swap/memory unconditionally, reported as covering both halves."""
    try:
        r = subprocess.run(["systemctl", "is-active", "systemd-oomd"],
                           capture_output=True, text=True, timeout=2)
        if r.stdout.strip() == "active":
            sections = _oomd_monitored_sections()
            if sections["swap"] or sections["pressure"]:
                return {"fighter": "systemd-oomd", "swap": sections["swap"],
                        "pressure": sections["pressure"]}
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        r = subprocess.run(["systemctl", "is-active", "earlyoom"],
                           capture_output=True, text=True, timeout=2)
        if r.stdout.strip() == "active":
            return {"fighter": "earlyoom", "swap": True, "pressure": True}
    except (OSError, subprocess.SubprocessError):
        pass
    return {"fighter": None, "swap": False, "pressure": False}


def _coexisting_oom_fighter():
    """Read-only: is systemd-oomd or earlyoom already fighting OOM here?
    Deliberately the BROAD either-section question — EITHER swap or
    pressure enrollment counts, since a merely-running-but-unenrolled
    oomd would wrongly tell RAMstein a backstop exists and stand down,
    but for THIS question (should RAMstein mention a fighter at all)
    partial coverage is still coverage. See _coexist_status for the full
    picture and _coexist_label for wording that names which half, when
    they disagree."""
    return _coexist_status()["fighter"]


def _coexist_label(status):
    """The coexist FACT rendered into a short label — used both by
    advise rule 5's sentence and by do_calm/do_kill's coexist_warning
    field, so the OR-collapse fix (thread 3dd73060) lives in one place
    instead of drifting across three copies. Same rule classify() applies
    to state_evidence: an OR'd condition must name WHICH half fired.
    Pressure-only enrollment (found live on the operator's machine,
    alfred DM #3250) covers none of RAMstein's own specialty — sustained
    swap exhaustion — and the old undifferentiated "systemd-oomd is
    active" line read identically whether swap was covered or not."""
    fighter = status["fighter"]
    if fighter is None:
        return None
    if fighter == "systemd-oomd" and status["swap"] != status["pressure"]:
        have = "swap" if status["swap"] else "pressure"
        missing = "pressure" if status["swap"] else "swap"
        return f"{fighter} ({have} only, not {missing})"
    return fighter


def _ledger_write(entry):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LEDGER_PATH, "a") as f:
        f.write(json.dumps(entry, separators=(",", ":")) + "\n")


def _persist_auto_calm_armed(config_path, armed):
    """`ramstein autocalm arm`/`dry`'s durability half — the persistence fix
    (DM #3074/#3079/#3080). Edits ONLY the one key, on the RAW file (not
    the merged/clamped `cfg` dict, which is full of defaults the operator
    never actually chose) so nothing else in an operator-tuned config.json
    gets silently rewritten to whatever the current defaults happen to be.
    Reuses sutra.write_status's atomic tmp+rename — its logic has nothing
    status.json-specific in it, just a name; a second file-writing helper
    here would only duplicate it. Best-effort: a write failure (e.g. the
    hardened unit's ReadWritePaths not covering config_path) must not crash
    the daemon or the in-memory arm/dry toggle it's piggybacking on — it
    only means the NEXT restart won't inherit this choice, not that this
    one silently failed to arm/disarm for real right now.
    """
    try:
        with open(config_path) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = {}
    if not isinstance(raw, dict):
        raw = {}
    raw["auto_calm_armed"] = armed
    try:
        sutra.write_status(config_path, raw, owner=None, mode=0o644)
    except OSError as exc:
        return str(exc)
    return None


def _cgroup_root():
    # An env override is honored ONLY when running unprivileged — a root
    # daemon must never let an environment variable redirect where it writes
    # real cgroup files (config-can't-weaken-safety doctrine, applied to
    # env). Tests run as an unprivileged user and use this to point at a
    # fake, writable cgroup tree instead of the real, unwritable one.
    root = os.environ.get("RAMSTEIN_CGROUP_ROOT")
    if root and os.getuid() != 0:
        return root
    return "/sys/fs/cgroup"


def _cgroup_path(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) == 3 and parts[0] == "0":  # cgroup v2 unified line
            return os.path.join(_cgroup_root(), parts[2].lstrip("/"))
    return None


def _mem_total_bytes():
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("MemTotal"):
                return int(line.split()[1]) * 1024
    return 0


def _parse_size(text):
    """'500M' / '2G' / 'max' -> bytes (None for 'max'). Raises on garbage
    or a non-positive size — hostile input, never silently clamped up."""
    if text == "max":
        return None
    units = {"K": 1024, "M": 1024 ** 2, "G": 1024 ** 3}
    unit = text[-1].upper() if text else ""
    try:
        n = float(text[:-1]) if unit in units else float(text)
    except ValueError:
        raise ValueError("bad size")
    value = n * units.get(unit, 1)
    if value <= 0:
        raise ValueError("size must be positive")
    return int(value)


def _find_proc(pid):
    return next((p for p in _read_procs() if p["pid"] == pid), None)


def query_resolve(target):
    """pid (as int or digit-string) matches by pid; anything else matches by
    exact comm — which, same as `ps`, is routinely NOT unique (multiple
    chrome/postgres/python processes), hence the caller must handle >1."""
    if isinstance(target, int) or (isinstance(target, str) and target.isdigit()):
        pid = int(target)
        matches = [p for p in _read_procs() if p["pid"] == pid]
    else:
        matches = [p for p in _read_procs() if p["comm"] == target]
    return {"matches": [
        {"pid": p["pid"], "comm": p["comm"], "rss": p["rss"], "swap": p["swap"],
         "starttime": p["starttime"]} for p in matches]}


def query_oom(get_status):
    doc = get_status()
    mem = doc.get("memory") if isinstance(doc, dict) else None
    candidates = []
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        try:
            with open(f"/proc/{pid}/oom_score") as f:
                score = int(f.read().strip())
        except (OSError, ValueError):
            continue
        try:
            with open(f"/proc/{pid}/status") as f:
                status = f.read()
        except OSError:
            continue
        if "VmRSS" not in status:
            continue
        comm, rss = None, 0
        for line in status.splitlines():
            key, _, rest = line.partition(":")
            if key == "Name":
                comm = rest.strip()
            elif key == "VmRSS":
                rss = int(rest.split()[0]) * 1024
        candidates.append({"pid": pid, "comm": comm or "?", "rss": rss,
                           "oom_score": score})
    candidates.sort(key=lambda c: c["oom_score"], reverse=True)
    return {"memory": mem, "candidates": candidates[:5]}


def query_advise(cfg, get_status):
    lines = []
    doc = get_status()
    mem = doc.get("memory") if isinstance(doc, dict) else None

    # rule 1: sustained pressure (avg60, not the twitchier avg10)
    if mem:
        some60 = mem["psi"].get("some_avg60")
        if some60 is not None and some60 > cfg["warn_psi_some"]:
            lines.append({"rule": "psi", "text":
                f"sustained pressure: PSI some avg60 {some60:.1f}%"
                f" > {cfg['warn_psi_some']:.1f}%"})

    # rule 2: top RSS grower over the recent ring (~1h), MiB/h rate
    con = _connect_index()
    try:
        head = _latest_sample(con)
        if head is not None:
            head_id, head_ts = head
            base = con.execute(
                "SELECT id, ts FROM samples WHERE ts <= ?"
                " ORDER BY ts DESC LIMIT 1", (head_ts - 3600,)).fetchone()
            if base is None:
                base = con.execute(
                    "SELECT id, ts FROM samples ORDER BY ts ASC LIMIT 1"
                ).fetchone()
            if base and base[0] != head_id:
                base_id, base_ts = base
                row = con.execute(
                    "SELECT h.pid, h.comm, h.rss - COALESCE(b.rss, 0)"
                    " FROM proc_stats h LEFT JOIN proc_stats b"
                    "   ON b.sample_id=? AND b.pid=h.pid"
                    "     AND b.starttime=h.starttime"
                    " WHERE h.sample_id=? ORDER BY 3 DESC LIMIT 1",
                    (base_id, head_id)).fetchone()
                span_s = (head_ts - base_ts) if row else 0
                # a short span extrapolated to an hourly rate is noise, not
                # signal — require at least 5 minutes of real history before
                # this rule speaks (freshly started daemon, thin ring, etc.)
                if row and span_s >= 300:
                    pid, comm, delta = row
                    rate = delta / (span_s / 3600.0)
                    threshold = cfg["advise_growth_mib_per_hour"] * 1024 ** 2
                    if rate > threshold:
                        lines.append({"rule": "growth", "text":
                            f"{comm} (pid {pid}) growing"
                            f" ~{rate / 1024 / 1024:.0f} MiB/h"})
    finally:
        con.close()

    # rule 3: swap occupancy > 50%, name the top tenant
    if mem and mem.get("swap_total", 0) > 0:
        used_pct = (100.0 * (mem["swap_total"] - mem["swap_free"])
                    / mem["swap_total"])
        if used_pct > 50.0:
            top = query_swap(1)
            tenant = (top.get("rows") or [None])[0]
            if tenant:
                lines.append({"rule": "swap", "text":
                    f"swap {used_pct:.0f}% full — top tenant {tenant['comm']}"
                    f" (pid {tenant['pid']}, {tenant['swap']}B)"})

    # rule 4: zombie-reaper advisory (V2.M1) — group by parent, only speak
    # once ONE parent has a real backlog (zombie_advise_min), not on a lone
    # stray about to be reaped normally; names the actual culprit with a
    # concrete reap suggestion, not just a count. The 12-real-zombies live
    # catch from M3 is exactly the shape this targets.
    zs = query_zombies()["rows"]
    if zs:
        tally = {}
        for z in zs:
            tally[z["parent_comm"]] = tally.get(z["parent_comm"], 0) + 1
        parent, count = max(tally.items(), key=lambda kv: kv[1])
        if count >= cfg["zombie_advise_min"]:
            lines.append({"rule": "zombies", "text":
                f"{parent} isn't reaping — {count} of {len(zs)} zombie(s)"
                f" unreaped are its children; restart it or send it a"
                f" signal that makes it wait()"})

    # rule 5: another OOM-fighter active — stand-down language, naming
    # which half when systemd-oomd's swap/pressure enrollment disagrees
    # (thread 3dd73060: an OR'd condition must carry which evidence fired)
    label = _coexist_label(_coexist_status())
    if label:
        lines.append({"rule": "coexist", "text":
            f"{label} is active — RAMstein's kill prompts stay"
            " advisory-only, standing down"})

    # rule 6: ETA under an hour — point at `oom`
    if mem:
        eta = mem.get("eta_oom_seconds")
        if eta is not None and eta < 3600:
            lines.append({"rule": "eta", "text":
                f"OOM ETA {eta}s — see `ramstein oom` for kill candidates"})

    # rule 7: shared memory (tmpfs/dev/shm/SysV+POSIX shm) is correctly
    # excluded from MemAvailable — the kernel can't reclaim it without
    # something actually deleting/freeing it — so it never shows up as
    # "the problem" anywhere else on this card even when it is the single
    # largest reclaimable block of RAM on the machine. Deliberately
    # SYSTEM-WIDE wording, not "/tmp": /proc/meminfo's Shmem sums every
    # tmpfs mount plus SysV/POSIX shared memory into one number, which is
    # NOT the same figure a /tmp-scoped tool (e.g. ByeByte's `why`) would
    # show for that one mount — two pills, two correctly different scopes
    # for the same underlying bytes, not a mismatch (Werner, DM #3228).
    if mem and mem.get("total"):
        shmem = mem.get("shmem", 0)
        shmem_pct = 100.0 * shmem / mem["total"]
        if shmem_pct > cfg["advise_shmem_pct"]:
            lines.append({"rule": "shmem", "text":
                f"{shmem / 1024**3:.1f}G ({shmem_pct:.0f}% of RAM) is shared"
                f" memory across the system (tmpfs/dev/shm/shared-memory"
                f" segments) — correctly excluded from available memory,"
                f" but some of it may be safely deletable; a disk-focused"
                f" pill (e.g. ByeByte) can show what's actually in it"})

    return {"lines": lines}


def build_pill_summary(cfg, get_status):
    """A compact M2/M3 digest embedded into status.json so the pill stays a
    one-file reader (GFileMonitor on status.json, no socket client in GJS)
    instead of growing its own daemon-protocol client. Computed on the
    sampler's own cadence (maybe_sample's return value), not every poll
    tick — advise's coexistence check spawns systemctl, and there is no
    reason to pay that cost 3x more often than the index itself refreshes."""
    con = _connect_index()
    try:
        top_process = None
        latest = _latest_sample(con)
        if latest is not None:
            sid, _ts = latest
            row = con.execute(
                "SELECT pid, comm, rss FROM proc_stats WHERE sample_id=?"
                " ORDER BY rss DESC LIMIT 1", (sid,)).fetchone()
            if row:
                top_process = {"pid": row[0], "comm": row[1], "rss": row[2]}
    finally:
        con.close()
    zombie_count = len(query_zombies()["rows"])
    advise = query_advise(cfg, get_status)
    lines = advise["lines"]
    return {
        "top_process": top_process,
        "zombie_count": zombie_count,
        "advise_headline": lines[0]["text"] if lines else None,
        "advise_count": len(lines),
    }


def do_calm(pid, starttime, action, size=None, nice=None):
    proc = _find_proc(pid)
    if proc is None:
        return {"error": "target process not found"}
    if proc["starttime"] != starttime:
        return {"error": "stale pid — starttime mismatch, refusing"}

    result = {"pid": pid, "comm": proc["comm"]}
    label = _coexist_label(_coexist_status())
    if label:
        result["coexist_warning"] = label

    if action == "nice":
        try:
            os.setpriority(os.PRIO_PROCESS, pid, nice)
        except OSError as exc:
            return {"error": f"renice failed: {exc.strerror}"}
        result.update(ok=True, nice=nice)
        _ledger_write({"ts": time.time(), "verb": "calm", "pid": pid,
                       "comm": proc["comm"], "arg": f"nice={nice}",
                       "result": "ok"})
        return result

    # high / release both write memory.high
    cpath = _cgroup_path(pid)
    high_file = os.path.join(cpath, "memory.high") if cpath else None
    if not high_file or not os.access(high_file, os.W_OK):
        return {"error": "cgroup memory.high not writable — try --nice"}
    if action == "release":
        write_val, value_bytes = "max", None
    else:
        requested = _parse_size(size)
        if requested is None:
            write_val, value_bytes = "max", None
        else:
            # docs/ARCHITECTURE.md: the floor is computed from the target's
            # OWN rss, so a tampered/fat-fingered SIZE can never be set low
            # enough to instant-thrash-OOM the thing calm is meant to help.
            floor = max(CALM_HIGH_FLOOR_BYTES, int(proc["rss"] * 1.1))
            clamped = max(floor, min(requested, _mem_total_bytes()))
            write_val, value_bytes = str(clamped), clamped
    try:
        with open(high_file, "w") as f:
            f.write(write_val)
    except OSError as exc:
        return {"error": f"write failed: {exc.strerror}"}
    result.update(ok=True, cgroup=cpath, memory_high=value_bytes)
    _ledger_write({"ts": time.time(), "verb": "calm", "pid": pid,
                   "comm": proc["comm"],
                   "arg": "release" if action == "release" else size,
                   "result": "ok"})
    return result


def do_kill(pid, starttime, confirm, sig):
    # invariant gates: confirm must echo pid (defense in depth against a
    # caller that sends pid without ever having gone through a real confirm
    # step), and pid 1 / the daemon's own pid are never valid — kernel
    # threads are already structurally excluded, _find_proc can't see them
    # (no VmRSS -> _read_procs skips them).
    if confirm != pid:
        return {"error": "confirm must equal pid"}
    if pid in (1, os.getpid()):
        return {"error": "refused: protected pid"}
    proc = _find_proc(pid)
    if proc is None:
        return {"error": "target process not found"}
    if proc["starttime"] != starttime:
        return {"error": "stale pid — starttime mismatch, refusing"}
    label = _coexist_label(_coexist_status())
    real_sig = signal.SIGKILL if sig == "KILL" else signal.SIGTERM
    try:
        os.kill(pid, real_sig)
    except OSError as exc:
        return {"error": f"kill failed: {exc.strerror}"}
    result = {"ok": True, "pid": pid, "comm": proc["comm"], "signal": sig}
    if label:
        result["coexist_warning"] = label
    _ledger_write({"ts": time.time(), "verb": "kill", "pid": pid,
                   "comm": proc["comm"], "arg": sig, "result": "ok"})
    return result


# --- V2.M2: auto-calm — arms the existing calm machinery to act on its own -
# Three independent consent gates, all required for a REAL (non-dry) action:
#   1. auto_calm_enabled (config, default False) — the feature exists at all
#   2. armed (config-persisted as auto_calm_armed as of the persistence fix
#      below, DM #3074/#3079/#3080 — `ramstein autocalm arm`/`dry` write it
#      to config.json AND flip the daemon's live autocalm_state in the same
#      act, so a restart inherits the last choice. Was runtime-only through
#      0.11.1, always resetting to dry-run on restart — an unreachable
#      standing protection, since nothing durable ever satisfied gate 2 for
#      longer than until the next reboot. The TTY confirmation on the FIRST
#      `arm` is unchanged; only the amnesia was the bug)
#   3. the ramstein-autocalm.timer unit being manually enabled — installed
#      but not enabled by default, so a cycle never even RUNS unless the
#      operator deliberately turned the schedule on
# do_autocalm_run is only ever invoked on demand (the socket "run" action,
# which the timer's service calls periodically) — never from the daemon's
# own continuous poll loop, so gates 2+3 both being satisfied is the only
# way anything happens on a schedule. Kill is never reachable from here at
# any setting — the graduated response stops at notify, always.

def do_autocalm_run(cfg, get_status, autocalm_state):
    def _settle(result):
        autocalm_state["last_result"] = result
        return result

    if not cfg["auto_calm_enabled"]:
        return _settle({"ok": True, "acted": False,
                        "reason": "auto_calm_enabled is false"})

    doc = get_status()
    mem = doc.get("memory") if isinstance(doc, dict) else None
    warning = doc.get("warning") if isinstance(doc, dict) else None
    if not mem:
        return _settle({"ok": True, "acted": False, "reason": "no status yet"})

    psi = mem.get("psi") or {}
    some10, full10 = psi.get("some_avg10"), psi.get("full_avg10")
    trigger = None
    if some10 is not None and some10 > cfg["auto_calm_psi_some"]:
        trigger = (f"PSI some avg10 {some10:.1f}% >"
                   f" {cfg['auto_calm_psi_some']:.1f}%")
    elif full10 is not None and full10 > cfg["auto_calm_psi_full"]:
        trigger = (f"PSI full avg10 {full10:.1f}% >"
                   f" {cfg['auto_calm_psi_full']:.1f}%")
    elif cfg["auto_calm_use_swap_storm"] and isinstance(warning, dict) \
            and warning.get("kind") == "swap_storm":
        trigger = "swap storm active (V2.M1 warning)"

    if trigger is None:
        return _settle({"ok": True, "acted": False,
                        "reason": "no trigger condition met"})

    armed = autocalm_state.get("armed", False)
    now = time.time()
    # cooldown only rate-limits REAL actions, tracked in its OWN field
    # (last_armed_action_ts) — last_action_ts below is the general "a cycle
    # ran" marker the pill/CLI display, and a dry-run cycle must keep that
    # fresh every tick (an operator watching "what would it do" shouldn't
    # see stale data) without it ever counting toward the cooldown.
    if armed:
        last_armed_ts = autocalm_state.get("last_armed_action_ts")
        if last_armed_ts is not None \
                and now - last_armed_ts < cfg["auto_calm_cooldown_seconds"]:
            remaining = cfg["auto_calm_cooldown_seconds"] - (now - last_armed_ts)
            return _settle({"ok": True, "acted": False, "trigger": trigger,
                            "reason": f"cooldown active ({remaining:.0f}s left)"})

    # target: the current top RSS grower — same figure the pill already
    # surfaces as top_process, no new selection logic
    rows = query_top(False, 1).get("rows") or []
    if not rows:
        return _settle({"ok": True, "acted": False, "trigger": trigger,
                        "reason": "no eligible target process"})
    proc = _find_proc(rows[0]["pid"])
    if proc is None:
        return _settle({"ok": True, "acted": False, "trigger": trigger,
                        "reason": "target vanished before action"})

    steps = []
    if cfg["auto_calm_step_renice"]:
        if armed:
            r = do_calm(proc["pid"], proc["starttime"], "nice",
                        nice=cfg["auto_calm_nice"])
        else:
            r = {"dry_run": True, "would": f"renice to {cfg['auto_calm_nice']}"}
        steps.append({"step": "renice", "result": r})
    if cfg["auto_calm_step_squeeze"]:
        squeeze_bytes = max(1, int(proc["rss"] * cfg["auto_calm_squeeze_pct"] / 100.0))
        if armed:
            r = do_calm(proc["pid"], proc["starttime"], "high",
                        size=str(squeeze_bytes))
        else:
            r = {"dry_run": True, "would": f"memory.high to ~{squeeze_bytes}B"}
        steps.append({"step": "squeeze", "result": r})

    # step 3, notify, is never a daemon-side action: a root systemd service
    # has no clean path into the operator's own desktop session. The daemon
    # only SURFACES the payload (status.json's "autocalm" field, read by
    # the already-running pill, which already has real notification access
    # in the right session) — same one-file architecture as everything else
    # the pill reads, no new daemon-protocol client needed in GJS.
    notify = {
        "pid": proc["pid"], "comm": proc["comm"], "trigger": trigger,
        "armed": armed, "steps": [s["step"] for s in steps],
        "suggested_kill": f"ramstein calm {proc['pid']} --kill",
    }
    result = {"ok": True, "acted": armed, "dry_run": not armed,
              "target": {"pid": proc["pid"], "comm": proc["comm"]},
              "trigger": trigger, "steps": steps, "notify": notify}
    autocalm_state["last_action_ts"] = now
    if armed:
        autocalm_state["last_armed_action_ts"] = now
        _ledger_write({"ts": now, "verb": "autocalm", "pid": proc["pid"],
                       "comm": proc["comm"], "arg": trigger,
                       "result": "acted", "steps": [s["step"] for s in steps]})
    return _settle(result)


def _live_autocalm_triggers(get_status):
    """Which of do_autocalm_run's OWN trigger conditions can this machine's
    kernel/config actually satisfy right now? PSI needs CONFIG_PSI
    (read_psi() degrades to all-None without it, ramsteind.py's own
    documented fallback -- "classify on meminfo alone"); the swap-storm
    fallback needs swap actually configured. Surfaced at arm time and in
    `autocalm status` so a human arming on a machine missing one or both
    learns that up front rather than by watching nothing happen for a
    month -- "must see what it thought and why," applied to CAPABILITY
    rather than to decisions (DM #3079/#3083)."""
    doc = get_status()
    mem = doc.get("memory") if isinstance(doc, dict) else {}
    mem = mem or {}
    psi = mem.get("psi") or {}
    psi_live = psi.get("some_avg10") is not None or psi.get("full_avg10") is not None
    swap_storm_live = bool(mem.get("swap_total"))
    return {"psi": psi_live, "swap_storm": swap_storm_live}


def query_autocalm_status(cfg, autocalm_state, get_status):
    return {
        "enabled": cfg["auto_calm_enabled"],
        "armed": autocalm_state.get("armed", False),
        "live_triggers": _live_autocalm_triggers(get_status),
        "policy": {
            "psi_some": cfg["auto_calm_psi_some"],
            "psi_full": cfg["auto_calm_psi_full"],
            "use_swap_storm": cfg["auto_calm_use_swap_storm"],
            "step_renice": cfg["auto_calm_step_renice"],
            "step_squeeze": cfg["auto_calm_step_squeeze"],
            "nice": cfg["auto_calm_nice"],
            "squeeze_pct": cfg["auto_calm_squeeze_pct"],
            "cooldown_seconds": cfg["auto_calm_cooldown_seconds"],
        },
        "last_action_ts": autocalm_state.get("last_action_ts"),
        "last_result": autocalm_state.get("last_result"),
    }


# --- V2.M3: oomd swap-enrollment — layer 3's first verb, built to ruling
# 41b72476 (a layer-3 verb succeeds when the pill's own OBSERVATION of the
# world changes, never merely when a file is written). Found live 2026-08-02
# (DM #3207/#3209/#3212): Ubuntu ships user@.service with
# ManagedOOMMemoryPressure=kill but nothing anywhere sets ManagedOOMSwap=
# kill — the exact scenario RAMstein exists for (sustained swap pressure)
# has zero stock coverage. This verb closes that gap the way systemd
# itself would: a new override drop-in, nothing hand-edited, undone the
# same way it was done.

_OOMD_ENROLL_DROPIN_REL = "user@.service.d/50-ramstein-oomd-enroll.conf"
_OOMD_ENROLL_DROPIN_BODY = "[Service]\nManagedOOMSwap=kill\n"


def _systemd_root():
    # Mirrors _cgroup_root()'s exact safety pattern: an env override is
    # honored ONLY when running unprivileged — a root daemon must never
    # let an environment variable redirect where it writes real systemd
    # unit files (config-can't-weaken-safety doctrine, applied to env).
    # Tests run as an unprivileged user and use this to point at a fake,
    # writable systemd tree instead of the real /etc/systemd/system —
    # and even a test that forgets to set it can't do real damage: an
    # unprivileged process can't write there anyway, it just fails clean.
    root = os.environ.get("RAMSTEIN_SYSTEMD_ROOT")
    if root and os.getuid() != 0:
        return root
    return "/etc/systemd/system"


def _oomd_enroll_dropin_path():
    return os.path.join(_systemd_root(), _OOMD_ENROLL_DROPIN_REL)


def _oomd_swap_used_limit_percent():
    """systemd-oomd's own LIVE SwapUsedLimit, read from oomctl rather than
    hardcoded — so _oomd_enroll_preflight can never drift from the
    daemon's actual running policy. Falls back to systemd's own compiled
    default (90%, confirmed against a stock install with no oomd.conf.d
    overrides, 2026-08-02) if oomctl is unreachable or the line isn't
    found — the conservative direction: a wrong-but-lower assumed limit
    only ever makes the pre-flight refuse MORE readily, never less."""
    try:
        r = subprocess.run(["oomctl"], capture_output=True, text=True,
                            timeout=2)
    except (OSError, subprocess.SubprocessError):
        return 90.0
    if r.returncode != 0:
        return 90.0
    for line in r.stdout.splitlines():
        if line.startswith("Swap Used Limit:"):
            try:
                return float(line.split(":", 1)[1].strip().rstrip("%"))
            except ValueError:
                break
    return 90.0


def _oomd_enroll_preflight(get_status):
    """Refuse enrollment — naming the remedy, never a bare denial (alfred's
    ruling: a refusal that names a better action is a redirect, not a
    wall) — if systemd-oomd's own swap-kill trigger condition ALREADY
    holds. Confirmed against systemd's own source (oomd-manager.c's
    monitor_swap_contexts_handler) and oomd.conf(5)'s SwapUsedLimit=: a
    CONJUNCTION — mem-used% AND swap-used% BOTH over the limit — with NO
    duration/hysteresis at all (unlike memory-pressure's
    ManagedOOMMemoryPressureDurationSec): it acts on the very next poll
    cycle. Enrolling while this already holds hands victim selection to
    oomd with zero time to react; RAMstein's own `oom` verb (surface
    candidates, human picks) is strictly better in that exact moment —
    same outcome, chosen target, no race. Per this conjunction, the
    refusal will almost never actually fire on a healthy machine — that
    is correct for a failsafe, not a sign it needs a richer UX.
    Returns None if safe to proceed, else a human-readable refusal."""
    doc = get_status()
    mem = doc.get("memory") if isinstance(doc, dict) else None
    if not mem or not mem.get("total"):
        return "no status yet — wait for the sampler, then retry"
    swap_total, swap_free = mem.get("swap_total"), mem.get("swap_free")
    if not swap_total:
        return ("no swap configured on this machine — there is nothing for"
                " swap-kill protection to watch")
    mem_used_pct = 100.0 * (1 - mem["available"] / mem["total"])
    swap_used_pct = 100.0 * (1 - swap_free / swap_total)
    limit = _oomd_swap_used_limit_percent()
    if mem_used_pct > limit and swap_used_pct > limit:
        return (
            f"refusing: memory ({mem_used_pct:.0f}% used) and swap"
            f" ({swap_used_pct:.0f}% used) are BOTH already past"
            f" systemd-oomd's own {limit:.0f}% trigger — enrolling now"
            f" would hand victim selection to oomd with no time to react."
            f" See `ramstein oom` for kill candidates and choose one"
            f" yourself first, or free memory, then retry enrollment.")
    return None


def _oomd_apply_enrollment(write):
    """Shared by enroll/disenroll: daemon-reload + restart systemd-oomd —
    the two steps proven necessary this session (a config-only write, or
    daemon-reload alone, does not make oomd re-discover units; only its
    own process restarting does) — then re-verify with the SAME detector
    built this morning as this afternoon's acceptance test (ruling
    41b72476) rather than trust the write. `write` is True for enroll
    (create the drop-in first), False for disenroll (remove it first).

    HONEST VERIFICATION STATUS (alfred's review, DM #3240/#3243, source
    checked against both systemd main and the v259 tag the operator
    actually runs): ManagedOOMSwap=kill is CONFIRMED AT THE REGISTRATION
    PATH to enter oomd's swap monitoring hashmap —
    process_managed_oom_message() in oomd-manager.c strips a cgroup from
    monitoring when its mode is AUTO (hashmap_remove) and inserts it
    otherwise (oomd_insert_cgroup_context), with no special-casing
    between the swap and memory-pressure properties. The empty "Swap
    Monitored CGroups" section observed live this session is fully
    explained by -.slice's stock `auto` being actively stripped, not by
    swap behaving differently from pressure at kill mode — pressure was
    only ever seen enrolled because user@.service's stock drop-in
    already sets it to kill, nothing about the registration mechanism
    itself differs. But it has NEVER been directly observed: no swap
    cgroup has appeared in that section on any machine looked at this
    session. "Confirmed in source, unobserved in practice" — keep both
    halves; don't round the source read up to "verified" and don't let
    the missing observation collapse back down to "untested". Shipped
    either way: the re-verify below is exactly what makes an unobserved
    path safe to ship — it reports FAILURE rather than trusting the
    write, the property Werner's ByeByte `declare` verb lacked when it
    silently ledgered a delete that never happened."""
    dropin = _oomd_enroll_dropin_path()
    try:
        if write:
            os.makedirs(os.path.dirname(dropin), exist_ok=True)
            with open(dropin, "w") as f:
                f.write(_OOMD_ENROLL_DROPIN_BODY)
        elif os.path.exists(dropin):
            os.remove(dropin)
    except OSError as exc:
        return {"ok": False, "error": f"drop-in write failed: {exc.strerror}"}

    for step in (["systemctl", "daemon-reload"],
                 ["systemctl", "restart", "systemd-oomd"]):
        try:
            r = subprocess.run(step, capture_output=True, text=True,
                               timeout=10)
        except (OSError, subprocess.SubprocessError) as exc:
            return {"ok": False, "error": f"{' '.join(step)} failed: {exc}"}
        if r.returncode != 0:
            return {"ok": False,
                    "error": f"{' '.join(step)} exited {r.returncode}: "
                             f"{(r.stderr or r.stdout).strip()}"}

    time.sleep(1)  # let oomd finish its own startup re-discovery
    # SWAP-specific, not _coexisting_oom_fighter's broad either-section
    # question — this verb enrolls ManagedOOMSwap=kill, so its own
    # acceptance test must measure the swap section alone, or a machine
    # with pressure already enrolled (every real machine, once verb #1's
    # own restart populates it) would report swap-protected when it is
    # not (alfred, DM #3250 — found live on the operator's machine).
    enrolled = _oomd_swap_enrolled()
    moved = enrolled if write else not enrolled
    result = {"ok": moved, "wrote": write, "dropin": dropin,
              "measured_enrolled": enrolled}
    if not moved:
        # Ruling 41b72476: a verb succeeds when the pill's own observation
        # changes, never merely because a file was written — name what
        # was written, what was measured, and that they disagree.
        result["error"] = (
            f"{'wrote' if write else 'removed'} {dropin} and restarted "
            f"systemd-oomd, but its Swap Monitored CGroups still reports "
            f"{'enrolled' if enrolled else 'not enrolled'} — the file "
            f"changed, the world didn't. Refusing to report success.")
    return result


def do_oomd_enroll(get_status):
    refusal = _oomd_enroll_preflight(get_status)
    if refusal:
        return {"ok": False, "error": refusal}
    result = _oomd_apply_enrollment(write=True)
    _ledger_write({"ts": time.time(), "verb": "oomd_enroll", "pid": None,
                   "comm": None, "arg": "user@.service ManagedOOMSwap=kill",
                   "result": "ok" if result["ok"] else "error",
                   "detail": result.get("error")})
    return result


def do_oomd_disenroll():
    result = _oomd_apply_enrollment(write=False)
    _ledger_write({"ts": time.time(), "verb": "oomd_disenroll", "pid": None,
                   "comm": None, "arg": "user@.service ManagedOOMSwap=kill",
                   "result": "ok" if result["ok"] else "error",
                   "detail": result.get("error")})
    return result


def query_oomd_status(get_status):
    return {
        # SWAP-specific — see _oomd_swap_enrolled's docstring on
        # _oomd_monitored_sections (alfred, DM #3250): this verb is about
        # swap protection, not "is oomd doing anything at all".
        "enrolled": _oomd_swap_enrolled(),
        "ramstein_dropin_present": os.path.exists(_oomd_enroll_dropin_path()),
        "preflight_would_refuse": _oomd_enroll_preflight(get_status),
    }


# --- layer 3, verb #2: vm.swappiness ----------------------------------------
# Approved table (decision f8e7cc5a): SEGMENT presets, CHEAP, PERSISTENT.
# The pill's SEGMENT is a small named-stance set; the daemon/CLI take the
# raw kernel value (0-200 — modern kernels accept up to 200 for MGLRU) since
# the CLI is for agents and experts and the pill maps its chip labels onto
# concrete numbers, not the other way around. First (cheapest) of the three
# verbs alfred sequenced tonight, per his own "swappiness first, swap-size
# second, zram last" ordering.

SWAPPINESS_MIN, SWAPPINESS_MAX = 0, 200
_SWAPPINESS_DROPIN_REL = "sysctl.d/90-ramstein-swappiness.conf"
_SWAPPINESS_PROC_PATH = "/proc/sys/vm/swappiness"


def _sysctl_root():
    # Mirrors _cgroup_root()/_systemd_root()'s exact safety pattern: an env
    # override is honored ONLY when running unprivileged.
    root = os.environ.get("RAMSTEIN_SYSCTL_ROOT")
    if root and os.getuid() != 0:
        return root
    return "/etc"


def _swappiness_dropin_path():
    return os.path.join(_sysctl_root(), _SWAPPINESS_DROPIN_REL)


def _swappiness_dropin_body(value):
    return f"vm.swappiness = {value}\n"


def _swappiness_proc_path():
    # /proc/sys/vm/swappiness is a live kernel interface, not a plain
    # writable tree — tests need their OWN fake file to read/write instead
    # of the real one, same override-only-when-unprivileged rule as
    # _cgroup_root(). Reading/writing this path directly (what sysctl(8)
    # itself does under the hood for a single scalar key) is simpler and
    # more testable than shelling out to `sysctl -w`, and the kernel
    # enforces its own accepted range on the write() syscall either way.
    root = os.environ.get("RAMSTEIN_PROC_SWAPPINESS")
    if root and os.getuid() != 0:
        return root
    return _SWAPPINESS_PROC_PATH


def _read_swappiness():
    try:
        with open(_swappiness_proc_path()) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def _write_swappiness_live(value):
    try:
        with open(_swappiness_proc_path(), "w") as f:
            f.write(str(value))
    except OSError as exc:
        return f"write to {_swappiness_proc_path()} failed: {exc.strerror}"
    return None


SWAPPINESS_PRIOR_PATH = os.path.join(STATE_DIR, "swappiness_prior.json")


def _swappiness_prior_read():
    try:
        with open(SWAPPINESS_PRIOR_PATH) as f:
            return json.load(f).get("prior")
    except (OSError, ValueError):
        return None


def _swappiness_prior_write_once(value):
    """Ledger the value from BEFORE RAMstein's first change — idempotent:
    a second or third `set` must never overwrite the true original with
    an intermediate RAMstein-chosen value, or `reset` would restore to
    the wrong number. Cleared by a successful reset (see
    do_swappiness_reset) so a later first-change re-ledgers fresh instead
    of a `reset` years later snapping back to a long-stale number."""
    if _swappiness_prior_read() is not None:
        return
    os.makedirs(STATE_DIR, exist_ok=True)
    sutra.write_status(SWAPPINESS_PRIOR_PATH, {"prior": value}, owner=None)


def do_swappiness_set(value):
    if not SWAPPINESS_MIN <= value <= SWAPPINESS_MAX:
        return {"error": f"value must be in {SWAPPINESS_MIN}..{SWAPPINESS_MAX}"}
    current = _read_swappiness()
    if current is None:
        return {"error": "could not read the current vm.swappiness"}
    _swappiness_prior_write_once(current)

    dropin = _swappiness_dropin_path()
    try:
        os.makedirs(os.path.dirname(dropin), exist_ok=True)
        with open(dropin, "w") as f:
            f.write(_swappiness_dropin_body(value))
    except OSError as exc:
        return {"ok": False, "error": f"drop-in write failed: {exc.strerror}"}

    live_err = _write_swappiness_live(value)
    measured = _read_swappiness()
    moved = measured == value
    result = {"ok": moved, "dropin": dropin, "requested": value,
              "measured": measured, "prior": _swappiness_prior_read()}
    if not moved:
        # ruling 41b72476: the pill's own observation must move, or this
        # reports failure — a written drop-in with an unmoved live value
        # is not success, it's a change that only takes effect on reboot
        result["error"] = live_err or (
            f"wrote {value} but the kernel now reports {measured!r} —"
            f" refusing to report success")
    _ledger_write({"ts": time.time(), "verb": "swappiness_set", "pid": None,
                   "comm": None, "arg": str(value),
                   "result": "ok" if result["ok"] else "error",
                   "detail": result.get("error")})
    return result


def do_swappiness_reset():
    prior = _swappiness_prior_read()
    if prior is None:
        return {"error": "nothing to reset — RAMstein has never changed"
                          " vm.swappiness on this machine"}
    dropin = _swappiness_dropin_path()
    try:
        if os.path.exists(dropin):
            os.remove(dropin)
    except OSError as exc:
        return {"ok": False, "error": f"drop-in removal failed: {exc.strerror}"}

    live_err = _write_swappiness_live(prior)
    measured = _read_swappiness()
    moved = measured == prior
    result = {"ok": moved, "restored_to": prior, "measured": measured}
    if not moved:
        result["error"] = live_err or (
            f"removed the drop-in but the kernel now reports {measured!r},"
            f" expected {prior!r} — refusing to report success")
    else:
        try:
            os.remove(SWAPPINESS_PRIOR_PATH)
        except OSError:
            pass
    _ledger_write({"ts": time.time(), "verb": "swappiness_reset", "pid": None,
                   "comm": None, "arg": str(prior),
                   "result": "ok" if result["ok"] else "error",
                   "detail": result.get("error")})
    return result


def query_swappiness_status():
    return {
        "current": _read_swappiness(),
        "ramstein_dropin_present": os.path.exists(_swappiness_dropin_path()),
        "prior": _swappiness_prior_read(),
    }


# --- layer 3, verb #3: swap file size ---------------------------------------
# Approved table (decision f8e7cc5a): BUTTON presets, BOUNDED-WAIT, PERSISTENT.
# A standalone backing file + a standalone systemd .swap unit, additive to
# whatever swap the machine already has (this box's own /swap.img stays
# fstab-based and untouched) -- never an fstab edit, so undoing it is disabling
# one unit, never untangling a shared file. The unit is SHIPPED statically by
# the package (installed, never enabled) with a fixed `What=`, so the daemon
# itself never writes a unit file here -- only the backing file inside
# /var/lib/ramstein, already covered by ReadWritePaths. Genuinely BOUNDED-WAIT
# (fallocate + mkswap scale with size), so `set` runs the real work on a
# background thread and reports `pending` immediately -- FAMILY.md: "a verb
# that may take minutes is not a control without a progress state."

SWAP_SIZE_MIN_BYTES = 64 * 1024 * 1024
# A .swap unit's name isn't arbitrary (unlike a .service): systemd
# requires it to be the path-escaped form of its own What= (systemd.
# swap(5)) -- `systemd-escape --path --suffix=swap /var/lib/ramstein/
# extra.img` -- or the unit fails to load entirely ("Value of What= and
# unit name do not match"), caught by systemd-analyze verify before this
# ever shipped. The backing file is named .img, not .swap, specifically
# so this escaped name doesn't end up double-suffixed.
_SWAP_SIZE_UNIT_NAME = "var-lib-ramstein-extra.img.swap"
_SWAP_SIZE_BACKING_REL = "extra.img"


def _swap_size_backing_file_path():
    return os.path.join(STATE_DIR, _SWAP_SIZE_BACKING_REL)


def _swapon_rows():
    """`swapon --show`, machine-parseable: --bytes/--noheadings/--raw give
    exact integer sizes and one space-separated row per active swap, no
    unit suffix guessing (a human-readable "8G" would need re-parsing the
    same size logic _parse_size already owns, for no benefit). Shared
    plumbing -- swap-size's own backing file and zram's device are both
    just rows in this same table, told apart by NAME (a file path vs.
    /dev/zramN)."""
    try:
        r = subprocess.run(
            ["swapon", "--show", "--bytes", "--noheadings", "--raw"],
            capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return []
    if r.returncode != 0:
        return []
    rows = []
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 3:
            try:
                rows.append({"name": parts[0], "type": parts[1],
                             "size": int(parts[2])})
            except ValueError:
                continue
    return rows


def _swap_size_active_bytes():
    path = _swap_size_backing_file_path()
    for row in _swapon_rows():
        if row["name"] == path:
            return row["size"]
    return 0


def _swap_size_disk_headroom_after(new_size_bytes):
    """Free bytes on the backing file's own filesystem AFTER this resize.
    The file's CURRENT size (if it already exists) is already counted
    against free space by statvfs, so only the DELTA (new minus current)
    is what actually consumes more disk -- a same-size or shrinking `set`
    never reports less free than statvfs already does."""
    path = _swap_size_backing_file_path()
    try:
        st = os.statvfs(os.path.dirname(path))
    except OSError:
        return None
    free = st.f_bavail * st.f_frsize
    current = os.path.getsize(path) if os.path.exists(path) else 0
    delta = new_size_bytes - current
    return free - delta if delta > 0 else free


def _swap_size_apply(size_bytes):
    """The BOUNDED-WAIT body, run off the request thread (see
    do_swap_size_set). `systemctl stop` first -- resizing or re-mkswap-ing
    a file that's CURRENTLY active swap corrupts it; idempotent (exit
    nonzero, ignored) if the unit was never started. Then allocate +
    mkswap + enable --now, and re-measure via swapon --show before ever
    reporting success (ruling 41b72476) -- a backing file written and a
    unit enabled is not success if the kernel doesn't actually show the
    swap active at the requested size.

    posix_fallocate, NOT truncate, for growth: a truncate-extended file
    is SPARSE (holes, no real blocks behind the new length), and both
    mkswap and swapon refuse a sparse swap file outright ("contains
    holes or other unsupported extents" / "skipping - it appears to have
    holes") -- confirmed live, on real ext4, not just theorized: a
    truncate-based first cut of this verb passed every offline test
    (which never allocates real disk) and only failed at the very last
    step, in an isolated container, against the real kernel. Shrinking
    uses ftruncate instead -- fallocate only ever grows.

    VERIFICATION STATUS, honestly: the fallocate->mkswap sequence and the
    honest-failure path are both directly confirmed live -- a raw
    `swapon` on the fallocate'd file (bypassing systemd entirely)
    succeeds cleanly on real ext4. `systemctl enable --now` on the
    STANDALONE UNIT specifically has never been observed succeeding in
    ANY test environment available here: systemd's own swap_start()
    (src/core/swap.c) contains `if (detect_container() > 0) return
    -EPERM;` -- an unconditional, no-override refusal of every .swap
    unit activation inside any detected container, confirmed by reading
    the source after hitting "Operation on or unit type of ... not
    supported on this system" in an isolated, privileged,
    --cgroupns=host, real-ext4-backed container (jrei/systemd-ubuntu),
    the same harness that verified swappiness and oomd enroll for real.
    That check runs before anything else in swap_start() and is the ONLY
    reason activation failed -- everything upstream of it (the file, its
    permissions, mkswap's signature) was independently confirmed correct
    via the raw swapon call. Confirmed in source and by an equivalent
    kernel-level call; never directly observed through the systemd unit
    path itself, and structurally can't be in any container-based
    harness. The operator's own machine is not a container."""
    path = _swap_size_backing_file_path()
    try:
        subprocess.run(["systemctl", "stop", _SWAP_SIZE_UNIT_NAME],
                       capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        pass

    try:
        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            current_size = os.fstat(fd).st_size
            if size_bytes > current_size:
                os.posix_fallocate(fd, current_size, size_bytes - current_size)
            elif size_bytes < current_size:
                os.ftruncate(fd, size_bytes)
            os.fchmod(fd, 0o600)
        finally:
            os.close(fd)
    except OSError as exc:
        return {"ok": False, "error": f"backing file write failed: {exc.strerror}"}

    try:
        r = subprocess.run(["mkswap", path], capture_output=True, text=True,
                           timeout=300)
    except (OSError, subprocess.SubprocessError) as exc:
        return {"ok": False, "error": f"mkswap failed: {exc}"}
    if r.returncode != 0:
        return {"ok": False, "error":
                f"mkswap exited {r.returncode}: {(r.stderr or r.stdout).strip()}"}

    for step in (["systemctl", "daemon-reload"],
                 ["systemctl", "enable", "--now", _SWAP_SIZE_UNIT_NAME]):
        try:
            r = subprocess.run(step, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as exc:
            return {"ok": False, "error": f"{' '.join(step)} failed: {exc}"}
        if r.returncode != 0:
            return {"ok": False, "error":
                    f"{' '.join(step)} exited {r.returncode}: "
                    f"{(r.stderr or r.stdout).strip()}"}

    measured = _swap_size_active_bytes()
    moved = measured == size_bytes
    result = {"ok": moved, "requested": size_bytes, "measured": measured}
    if not moved:
        result["error"] = (
            f"wrote a {size_bytes}-byte backing file and enabled"
            f" {_SWAP_SIZE_UNIT_NAME}, but swapon --show now reports"
            f" {measured!r} — refusing to report success")
    return result


def _swap_size_worker(size_bytes, swap_size_state):
    result = _swap_size_apply(size_bytes)
    swap_size_state["in_progress"] = False
    swap_size_state["last_result"] = result
    _ledger_write({"ts": time.time(), "verb": "swap_size_set", "pid": None,
                   "comm": None, "arg": str(size_bytes),
                   "result": "ok" if result.get("ok") else "error",
                   "detail": result.get("error")})


def do_swap_size_set(cfg, size_bytes, swap_size_state):
    if size_bytes < SWAP_SIZE_MIN_BYTES:
        return {"error": f"size must be at least {SWAP_SIZE_MIN_BYTES} bytes"}
    if swap_size_state.get("in_progress"):
        return {"error": "a swap-size change is already in progress —"
                          " see `swap-size status`"}
    headroom = _swap_size_disk_headroom_after(size_bytes)
    if headroom is None:
        return {"error": "could not stat the backing filesystem"}
    floor_gb = cfg["swap_size_min_disk_headroom_gb"]
    if headroom < floor_gb * 1024 ** 3:
        return {"error":
            f"refusing: only {headroom / 1024**3:.1f}G would remain free on"
            f" disk after this resize (floor {floor_gb:.0f}G) — an oversized"
            f" swap file trades a RAM crisis for a disk crisis"}

    swap_size_state["in_progress"] = True
    swap_size_state["requested"] = size_bytes
    threading.Thread(target=_swap_size_worker, args=(size_bytes, swap_size_state),
                     daemon=True).start()
    return {"pending": True, "requested": size_bytes}


def do_swap_size_remove():
    path = _swap_size_backing_file_path()
    if not os.path.exists(path) and _swap_size_active_bytes() == 0:
        return {"error": "no RAMstein-managed swap file to remove"}
    try:
        subprocess.run(["systemctl", "disable", "--now", _SWAP_SIZE_UNIT_NAME],
                       capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        return {"ok": False, "error": f"systemctl disable --now failed: {exc}"}
    try:
        if os.path.exists(path):
            os.remove(path)
    except OSError as exc:
        return {"ok": False, "error": f"file removal failed: {exc.strerror}"}
    measured = _swap_size_active_bytes()
    moved = measured == 0
    result = {"ok": moved, "measured": measured}
    if not moved:
        result["error"] = (
            f"removed the backing file but swapon --show still reports"
            f" {measured!r} bytes active — refusing to report success")
    _ledger_write({"ts": time.time(), "verb": "swap_size_remove", "pid": None,
                   "comm": None, "arg": None,
                   "result": "ok" if result["ok"] else "error",
                   "detail": result.get("error")})
    return result


def query_swap_size_status(swap_size_state):
    return {
        "active_bytes": _swap_size_active_bytes(),
        "backing_file_present": os.path.exists(_swap_size_backing_file_path()),
        "in_progress": swap_size_state.get("in_progress", False),
        "last_result": swap_size_state.get("last_result"),
        "disk_headroom_bytes": _swap_size_disk_headroom_after(0),
    }


# --- layer 3, verb #4: zram --------------------------------------------------
# Approved table (decision f8e7cc5a): TOGGLE, BOUNDED-WAIT, PERSISTENT.
# Compressed RAM-backed swap via systemd-zram-generator's own mechanism.
# RAMstein writes /etc/systemd/zram-generator.conf DIRECTLY, not via a
# drop-in -- the one deliberate exception to that preference (FAMILY.md):
# this file is self-contained and "deletable", inert the moment its
# [zram0] section is absent, none of an fstab edit's brick-the-boot risk.
# daemon-reload re-runs the generator (systemd's own mechanism for
# picking up a changed config), then start/stop the resulting
# systemd-zram-setup@zram0.service -- a plain oneshot .service, NOT a
# .swap unit, so it does NOT hit swap_start()'s container-detection
# refusal (confirmed by starting it directly in the same container that
# proved swap-size's ceiling, not inferred from the unit type). What DOES
# block full activation in every environment available here: the zram
# kernel module was never loaded on this machine, and loading it is a
# host-level action outside this verb's own scope to take unasked.

_ZRAM_DEVICE = "zram0"
_ZRAM_SETUP_UNIT = f"systemd-zram-setup@{_ZRAM_DEVICE}.service"
_ZRAM_CONFIG_REL = "systemd/zram-generator.conf"
_ZRAM_GENERATOR_BIN = "/usr/lib/systemd/system-generators/zram-generator"
_ZRAM_CONFIG_HEADER = ("# Managed by ramstein (`ramstein zram enable|disable`)"
                        " -- never hand edit.\n")
_ZRAM_CONFIG_ENABLED_BODY = (
    _ZRAM_CONFIG_HEADER +
    f"[{_ZRAM_DEVICE}]\n"
    "zram-size = ram / 2\n"
    "compression-algorithm = zstd\n"
)
_ZRAM_CONFIG_DISABLED_BODY = (
    _ZRAM_CONFIG_HEADER +
    f"# {_ZRAM_DEVICE} section removed -- zram-generator creates nothing.\n"
)


def _zram_config_path():
    # Mirrors _cgroup_root()/_systemd_root()'s exact safety pattern.
    root = os.environ.get("RAMSTEIN_ZRAM_ETC_ROOT")
    if root and os.getuid() != 0:
        return os.path.join(root, _ZRAM_CONFIG_REL)
    return os.path.join("/etc", _ZRAM_CONFIG_REL)


def _zram_generator_bin():
    # Mirrors _cgroup_root()'s exact safety pattern -- lets tests fake
    # "package installed" without touching the real generator path.
    root = os.environ.get("RAMSTEIN_ZRAM_GENERATOR_BIN")
    if root and os.getuid() != 0:
        return root
    return _ZRAM_GENERATOR_BIN


def _zram_generator_present():
    return os.path.exists(_zram_generator_bin())


def _zram_config_has_section():
    try:
        with open(_zram_config_path()) as f:
            content = f.read()
    except OSError:
        return False
    return f"[{_ZRAM_DEVICE}]" in content


def _zram_device_active_bytes():
    dev = f"/dev/{_ZRAM_DEVICE}"
    for row in _swapon_rows():
        if row["name"] == dev:
            return row["size"]
    return 0


def _zram_apply(enable):
    """The BOUNDED-WAIT body, run off the request thread (see
    do_zram_enable/do_zram_disable). Writes the config, daemon-reload
    (re-runs the generator), start/stop the setup unit, then re-measures
    via swapon --show before ever reporting success (ruling 41b72476) --
    a rewritten config and a "successful" systemctl call are not success
    if the device doesn't actually show the expected state."""
    if not _zram_generator_present():
        return {"ok": False, "error":
                "systemd-zram-generator is not installed"
                " (package: systemd-zram-generator)"}
    config = _zram_config_path()
    try:
        os.makedirs(os.path.dirname(config), exist_ok=True)
        with open(config, "w") as f:
            f.write(_ZRAM_CONFIG_ENABLED_BODY if enable else _ZRAM_CONFIG_DISABLED_BODY)
    except OSError as exc:
        return {"ok": False, "error": f"config write failed: {exc.strerror}"}

    for step in (["systemctl", "daemon-reload"],
                 ["systemctl", "start" if enable else "stop", _ZRAM_SETUP_UNIT]):
        try:
            r = subprocess.run(step, capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as exc:
            return {"ok": False, "error": f"{' '.join(step)} failed: {exc}"}
        if r.returncode != 0:
            return {"ok": False, "error":
                    f"{' '.join(step)} exited {r.returncode}: "
                    f"{(r.stderr or r.stdout).strip()}"}

    measured = _zram_device_active_bytes()
    moved = (measured > 0) if enable else (measured == 0)
    result = {"ok": moved, "enabled": enable, "measured": measured}
    if not moved:
        result["error"] = (
            f"wrote the config and {'started' if enable else 'stopped'}"
            f" {_ZRAM_SETUP_UNIT}, but swapon --show now reports"
            f" {measured!r} bytes on /dev/{_ZRAM_DEVICE} — refusing to"
            f" report success")
    return result


def _zram_worker(enable, zram_state):
    result = _zram_apply(enable)
    zram_state["in_progress"] = False
    zram_state["last_result"] = result
    _ledger_write({"ts": time.time(),
                   "verb": "zram_enable" if enable else "zram_disable",
                   "pid": None, "comm": None, "arg": None,
                   "result": "ok" if result.get("ok") else "error",
                   "detail": result.get("error")})


def _zram_start(enable, zram_state):
    if zram_state.get("in_progress"):
        return {"error": "a zram change is already in progress —"
                          " see `zram status`"}
    zram_state["in_progress"] = True
    threading.Thread(target=_zram_worker, args=(enable, zram_state),
                     daemon=True).start()
    return {"pending": True}


def do_zram_enable(zram_state):
    return _zram_start(True, zram_state)


def do_zram_disable(zram_state):
    return _zram_start(False, zram_state)


def query_zram_status(zram_state):
    return {
        "generator_present": _zram_generator_present(),
        "config_enabled": _zram_config_has_section(),
        "active_bytes": _zram_device_active_bytes(),
        "in_progress": zram_state.get("in_progress", False),
        "last_result": zram_state.get("last_result"),
    }


# --- control socket ---------------------------------------------------------
# The security seam (SO_PEERCRED-gated, bounded reads, hostile-input framing,
# the listen(64) backlog M4's attack suite demanded) lives in
# sutra.ControlServer now. This dispatch closure carries only the domain
# commands; ping/status are sutra's job.

def _make_dispatch(cfg, get_status, autocalm_state, config_path, swap_size_state,
                   zram_state):
    def dispatch(cmd, req):
        if cmd == "top":
            by_swap = req.get("swap", False)
            if not isinstance(by_swap, bool):
                raise ValueError("swap must be a bool")
            return query_top(by_swap, _limit(req))
        if cmd == "swap":
            return query_swap(_limit(req))
        if cmd == "blame":
            since = req.get("since")
            if not isinstance(since, (int, float)) or since <= 0:
                raise ValueError("since must be a positive epoch timestamp")
            return query_blame(float(since), _limit(req))
        if cmd == "zombies":
            return query_zombies()
        if cmd == "resolve":
            target = req.get("target")
            if not isinstance(target, str) or not target:
                raise ValueError("target must be a non-empty string")
            return query_resolve(target)
        if cmd == "oom":
            return query_oom(get_status)
        if cmd == "advise":
            return query_advise(cfg, get_status)
        if cmd == "calm":
            pid = req.get("pid")
            starttime = req.get("starttime")
            action = req.get("action")
            if not isinstance(pid, int) or not isinstance(starttime, int):
                raise ValueError("pid/starttime must be ints")
            if action == "high":
                size = req.get("size")
                if not isinstance(size, str) or not size:
                    raise ValueError("size must be a non-empty string")
                return do_calm(pid, starttime, "high", size=size)
            if action == "release":
                return do_calm(pid, starttime, "release")
            if action == "nice":
                nice = req.get("nice")
                if not isinstance(nice, int) or not NICE_MIN <= nice <= NICE_MAX:
                    raise ValueError(
                        f"nice must be an int in {NICE_MIN}..{NICE_MAX}")
                return do_calm(pid, starttime, "nice", nice=nice)
            raise ValueError("unknown calm action")
        if cmd == "kill":
            pid = req.get("pid")
            starttime = req.get("starttime")
            confirm = req.get("confirm")
            sig = req.get("sig", "TERM")
            if not isinstance(pid, int) or not isinstance(starttime, int) \
                    or not isinstance(confirm, int):
                raise ValueError("pid/starttime/confirm must be ints")
            if sig not in ("TERM", "KILL"):
                raise ValueError("sig must be TERM or KILL")
            return do_kill(pid, starttime, confirm, sig)
        if cmd == "autocalm":
            action = req.get("action")
            if action == "status":
                return query_autocalm_status(cfg, autocalm_state, get_status)
            if action == "arm":
                autocalm_state["armed"] = True
                persist_err = _persist_auto_calm_armed(config_path, True)
                resp = {"ok": True, "armed": True}
                if persist_err:
                    resp["persist_warning"] = (
                        f"armed for this session, but couldn't persist to "
                        f"{config_path} — a restart will forget it: {persist_err}")
                return resp
            if action == "dry":
                autocalm_state["armed"] = False
                persist_err = _persist_auto_calm_armed(config_path, False)
                resp = {"ok": True, "armed": False}
                if persist_err:
                    resp["persist_warning"] = (
                        f"disarmed for this session, but couldn't persist to "
                        f"{config_path}: {persist_err}")
                return resp
            if action == "run":
                return do_autocalm_run(cfg, get_status, autocalm_state)
            raise ValueError("unknown autocalm action")
        if cmd == "oomd":
            action = req.get("action")
            if action == "status":
                return query_oomd_status(get_status)
            if action == "enroll":
                return do_oomd_enroll(get_status)
            if action == "disenroll":
                return do_oomd_disenroll()
            raise ValueError("unknown oomd action")
        if cmd == "swappiness":
            action = req.get("action")
            if action == "status":
                return query_swappiness_status()
            if action == "set":
                value = req.get("value")
                if not isinstance(value, int):
                    raise ValueError("value must be an int")
                return do_swappiness_set(value)
            if action == "reset":
                return do_swappiness_reset()
            raise ValueError("unknown swappiness action")
        if cmd == "swap-size":
            action = req.get("action")
            if action == "status":
                return query_swap_size_status(swap_size_state)
            if action == "set":
                size = req.get("size")
                if not isinstance(size, str) or not size:
                    raise ValueError("size must be a non-empty string")
                try:
                    size_bytes = _parse_size(size)
                except ValueError as exc:
                    raise ValueError(str(exc))
                if size_bytes is None:
                    raise ValueError("size must be a concrete value, not 'max'")
                return do_swap_size_set(cfg, size_bytes, swap_size_state)
            if action == "remove":
                return do_swap_size_remove()
            raise ValueError("unknown swap-size action")
        if cmd == "zram":
            action = req.get("action")
            if action == "status":
                return query_zram_status(zram_state)
            if action == "enable":
                return do_zram_enable(zram_state)
            if action == "disable":
                return do_zram_disable(zram_state)
            raise ValueError("unknown zram action")
        return None  # unknown -> sutra frames {"error": "unknown command"}
    return dispatch


# --- main -------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(prog="ramsteind")
    ap.add_argument("--config", default="/etc/ramstein/config.json")
    ap.add_argument("--once", action="store_true",
                    help="single poll, write status, exit")
    args = ap.parse_args()

    cfg = load_config(args.config)
    os.makedirs(RUNTIME_DIR, exist_ok=True)

    stop = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.set())

    state = {}
    latest = {"doc": {"error": "no status yet"}}
    pill_cache = {"summary": None}
    # V2.M2, persisted as of the persistence fix (DM #3074/#3079/#3080):
    # seeds from config.json's auto_calm_armed rather than always starting
    # disarmed, so a restart inherits the operator's last choice instead of
    # forgetting it every time. last_action_ts/last_result are still
    # runtime-only (session-scoped history, not durable state).
    autocalm_state = {"armed": cfg["auto_calm_armed"],
                      "last_action_ts": None, "last_result": None}
    # swap-size's own runtime-only state -- BOUNDED-WAIT (fallocate+mkswap
    # scale with size), so `set` runs on a background thread and this dict
    # is how `status` sees whether it's still running and what the last
    # attempt's outcome was. Session-scoped like autocalm_state's own
    # last_result; a daemon restart mid-resize just means the NEXT set
    # redoes the whole (idempotent) sequence rather than resuming one.
    swap_size_state = {"in_progress": False, "requested": None,
                       "last_result": None}
    # zram's own BOUNDED-WAIT state, same shape as swap_size_state.
    zram_state = {"in_progress": False, "last_result": None}
    sampler = Sampler(cfg)
    dispatch = _make_dispatch(cfg, lambda: latest["doc"], autocalm_state,
                              args.config, swap_size_state, zram_state)
    ctl = sutra.ControlServer(SOCKET_PATH,
                              sutra.allow_uids({0, os.getuid(), cfg["owner_uid"]}),
                              VERSION, dispatch, lambda: latest["doc"],
                              socket_owner=(cfg["owner_uid"], -1))
    ctl.start()

    while not stop.is_set():
        now = time.time()
        mem = poll_memory(state, cfg, now)
        doc = {
            "v": 1,
            "ts": now,
            "daemon": {"version": VERSION, "pid": os.getpid(),
                       "poll_interval": cfg["poll_interval"]},
            "memory": mem,
            "warning": poll_swap_storm(state, cfg, now, mem["swap_total"],
                                       mem["swap_free"], mem["eta_oom_seconds"]),
            # cheap (in-memory dict read, no I/O) — rides along every poll so
            # the pill's GFileMonitor sees a fresh autocalm result as soon as
            # the NEXT regular tick lands, without autocalm needing its own
            # write path
            "autocalm": {"enabled": cfg["auto_calm_enabled"],
                        "armed": autocalm_state["armed"],
                        "last_action_ts": autocalm_state["last_action_ts"],
                        "last_result": autocalm_state["last_result"]},
        }
        latest["doc"] = doc
        # pill summary refreshes on the sampler's own cadence (not every
        # tick — see build_pill_summary), reusing the last one otherwise
        if sampler.maybe_sample(now):
            pill_cache["summary"] = build_pill_summary(cfg, lambda: latest["doc"])
        doc["pill"] = pill_cache["summary"]
        latest["doc"] = doc
        write_status(doc, cfg)
        if args.once:
            break
        stop.wait(cfg["poll_interval"])


if __name__ == "__main__":
    main()
