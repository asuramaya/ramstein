#!/usr/bin/env python3
"""ramstein — verb CLI over the ramsteind control socket.

Read-only in M0. Talks to the daemon's socket; falls back to reading
status.json so `ramstein status` still answers even mid-daemon-restart —
and must keep answering from a bare TTY at 100% memory pressure.
"""

import json
import os
import sys
import time

# --- sutra bootstrap (sutra 0.11.1; see docs/BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "ramstein"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra

RUNTIME_DIR = os.environ.get("RAMSTEIN_RUNTIME_DIR", "/run/ramstein")

PLANNED = {}


def request(payload):
    """One JSON command to the daemon; None if the socket is unreachable."""
    sock_path = os.path.join(RUNTIME_DIR, "control.sock")
    return sutra.request(sock_path, payload, timeout=10)


def request_or_die(payload, as_json=False):
    """as_json=True (pass the caller's own "--json" in argv) makes a daemon
    refusal exit through stdout as parseable {"error": ...} JSON instead of
    sys.exit's plain-text stderr line -- byebyte's own fix (Werner), ported
    here after finding the identical gap wiring the pill's own
    subprocess+--json calls to autocalm arm: sys.exit always fired BEFORE
    a verb's own --json print ever ran, so every refusal (a preflight
    refusal, an out-of-range value, a write that failed) silently never
    reached stdout at all -- a caller parsing --json output saw empty
    stdout and could only tell "something failed", never why,
    indistinguishable from the daemon being unreachable."""
    doc = request(payload)
    if doc is None:
        if as_json:
            print(json.dumps({"error": "daemon unreachable"}))
            sys.exit(1)
        sys.exit("ramstein: daemon unreachable — is ramsteind running?")
    if isinstance(doc, dict) and "error" in doc:
        if as_json:
            print(json.dumps(doc, indent=2))
            sys.exit(1)
        sys.exit(f"ramstein: {doc['error']}")
    return doc


def fetch():
    doc = request({"cmd": "status"})
    if isinstance(doc, dict) and "memory" in doc:
        return doc
    doc = sutra.read_status(os.path.join(RUNTIME_DIR, "status.json"))
    if doc is None:
        sys.exit("ramstein: no daemon and no status.json — is ramsteind "
                 "running?")
    return doc


def _flag_val(argv, name, default):
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return default


def parse_since(text, now):
    """'30s' / '10m' / '2h' / '1d' or 'YYYY-MM-DD' -> epoch seconds."""
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    if text and text[-1] in units:
        try:
            return now - float(text[:-1]) * units[text[-1]]
        except ValueError:
            pass
    try:
        return time.mktime(time.strptime(text, "%Y-%m-%d"))
    except ValueError:
        sys.exit(f"ramstein: bad --since '{text}' (want 30s / 10m / 2h / 1d"
                 " or YYYY-MM-DD)")


def human_bytes(n):
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n / 1.0:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}T"


def human_burn(bps):
    if abs(bps) < 1024 * 1024:  # under 1 MiB/s: churn, not a fire
        return "quiet"
    return f"{human_bytes(bps)}/s"


def human_psi(psi):
    some, full = psi.get("some_avg10"), psi.get("full_avg10")
    if some is None and full is None:
        return "—"
    def fmt(v):
        return "?" if v is None else f"{v:.1f}"
    return f"some {fmt(some)}/full {fmt(full)}"


def human_eta(seconds):
    if seconds is None:
        return "—"
    if seconds >= 2 * 86400:
        return f"~{seconds // 86400}d"
    if seconds >= 2 * 3600:
        return f"~{seconds // 3600}h"
    if seconds >= 120:
        return f"~{seconds // 60}m"
    return f"~{seconds}s"


FLAGS = {"ok": " ", "warn": "!", "hot": "‼"}


def cmd_status(argv):
    doc = fetch()
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    age = int(time.time() - doc["ts"])
    m = doc["memory"]
    flag = FLAGS.get(m["state"], "?")
    print(f"ramstein v{doc['daemon']['version']}   (status {age}s old)")
    print(f" {flag} mem {human_bytes(m['available'])} available "
          f"of {human_bytes(m['total'])}   "
          f"swap {human_bytes(m['swap_free'])} free "
          f"of {human_bytes(m['swap_total'])}   "
          f"pressure {human_psi(m['psi'])}   "
          f"burn {human_burn(m['burn_bps'])}   "
          f"OOM {human_eta(m['eta_oom_seconds'])}")


def cmd_top(argv):
    by_swap = "--swap" in argv
    limit = int(_flag_val(argv, "--limit", "20"))
    doc = request_or_die({"cmd": "top", "swap": by_swap, "limit": limit})
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    age = human_eta(int(time.time() - doc["ts"])).lstrip("~") or "0s"
    print(f"top by {'swap' if by_swap else 'rss'}   (sample {age} ago)")
    print(f"{'RSS':>8} {'SWAP':>8}   {'PID':>7}  PROC")
    for r in doc["rows"]:
        flag = "Z " if r["state"] == "Z" else "  "
        print(f"{human_bytes(r['rss']):>8} {human_bytes(r['swap']):>8}"
              f"   {r['pid']:>7}  {flag}{r['comm']}")
    if not doc["rows"]:
        print("  (nothing above the index threshold yet)")


def cmd_swap(argv):
    limit = int(_flag_val(argv, "--limit", "20"))
    doc = request_or_die({"cmd": "swap", "limit": limit})
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    age = human_eta(int(time.time() - doc["ts"])).lstrip("~") or "0s"
    print(f"parked in swap   (sample {age} ago)")
    print(f"{'SWAP':>8} {'RSS':>8}   {'PID':>7}  PROC")
    for r in doc["rows"]:
        print(f"{human_bytes(r['swap']):>8} {human_bytes(r['rss']):>8}"
              f"   {r['pid']:>7}  {r['comm']}")
    if not doc["rows"]:
        print("  nothing parked in swap")


def cmd_blame(argv):
    now = time.time()
    since = parse_since(_flag_val(argv, "--since", "10m"), now)
    limit = int(_flag_val(argv, "--limit", "20"))
    doc = request_or_die({"cmd": "blame", "since": since, "limit": limit})
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    span = human_eta(int(doc["head_ts"] - doc["base_ts"])).lstrip("~") or "0s"
    print(f"RSS movers over the last {span}:")
    for r in doc["rows"]:
        sign = "+" if r["delta"] >= 0 else ""
        tag = " new" if r["new"] else (" gone" if r["gone"] else "")
        print(f"  {sign}{human_bytes(r['delta']):>8}  {r['comm']:<16}"
              f" pid {r['pid']:<7} (now {human_bytes(r['rss'])}){tag}")
    if not doc["rows"]:
        print("  nothing moved above the index threshold")


def cmd_zombies(argv):
    doc = request_or_die({"cmd": "zombies"})
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    rows = doc["rows"]
    if not rows:
        print("no zombies")
        return
    print(f"{'PID':>7}  PROC              PPID  PARENT")
    for r in rows:
        print(f"{r['pid']:>7}  {r['comm']:<16}  {r['ppid']:>5}"
              f"  {r['parent_comm']}")


def cmd_oom(argv):
    doc = request_or_die({"cmd": "oom"})
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    mem = doc.get("memory") or {}
    if mem:
        print(f"available {human_bytes(mem.get('available', 0))} of "
              f"{human_bytes(mem.get('total', 0))}   "
              f"pressure {human_psi(mem.get('psi', {}))}   "
              f"burn {human_burn(mem.get('burn_bps', 0))}   "
              f"OOM {human_eta(mem.get('eta_oom_seconds'))}")
    print("who dies first (by oom_score):")
    for c in doc.get("candidates", []):
        print(f"  {c['oom_score']:>5}  {human_bytes(c['rss']):>8}"
              f"   {c['pid']:>7}  {c['comm']}")
    if not doc.get("candidates"):
        print("  (no candidates)")


def cmd_advise(argv):
    doc = request_or_die({"cmd": "advise"})
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    lines = doc.get("lines", [])
    if not lines:
        print("nothing to advise — looks calm")
        return
    for line in lines:
        print(f"- {line['text']}")


def _resolve_or_die(target):
    doc = request_or_die({"cmd": "resolve", "target": target})
    matches = doc.get("matches", [])
    if not matches:
        sys.exit(f"ramstein: no process matches '{target}'")
    if len(matches) > 1:
        rows = "\n".join(
            f"  pid {m['pid']:<7} {human_bytes(m['rss']):>8}  {m['comm']}"
            for m in matches)
        sys.exit(f"ramstein: '{target}' is ambiguous — {len(matches)} "
                 f"matches:\n{rows}\npass a pid instead")
    return matches[0]


def _print_coexist_warning(doc):
    if doc.get("coexist_warning"):
        print(f"! {doc['coexist_warning']} is active — proceeding, but it "
              "may already be handling this")


def cmd_calm(argv):
    if not argv or argv[0].startswith("-"):
        sys.exit("ramstein: calm needs a target pid or comm — "
                 "calm <pid|comm> [--high SIZE|--release|--nice N|--kill]")
    target, rest = argv[0], argv[1:]
    m = _resolve_or_die(target)
    pid, comm, starttime = m["pid"], m["comm"], m["starttime"]

    if "--kill" in rest:
        if not sys.stdin.isatty():
            sys.exit("ramstein: --kill refuses a non-interactive TTY")
        try:
            typed = input(f"really kill {pid} ({comm})? type its PID to "
                         "confirm: ").strip()
        except EOFError:
            typed = ""
        if typed != str(pid):
            sys.exit("ramstein: kill not confirmed")
        doc = request_or_die({"cmd": "kill", "pid": pid, "starttime": starttime,
                              "confirm": pid, "sig": "TERM"})
        _print_coexist_warning(doc)
        print(f"SIGTERM sent to {pid} ({comm})")
        for _ in range(10):
            if not os.path.exists(f"/proc/{pid}"):
                print(f"{pid} exited")
                return
            time.sleep(0.5)
        if sys.stdin.isatty():
            try:
                ans = input(f"{pid} still alive after 5s — SIGKILL? "
                           "[y/N] ").strip().lower()
            except EOFError:
                ans = ""
            if ans in ("y", "yes"):
                request_or_die({"cmd": "kill", "pid": pid,
                                "starttime": starttime, "confirm": pid,
                                "sig": "KILL"})
                print(f"SIGKILL sent to {pid}")
                return
        print(f"{pid} left alone (still alive after SIGTERM)")
        return

    if "--release" in rest:
        doc = request_or_die({"cmd": "calm", "pid": pid, "starttime": starttime,
                              "action": "release"})
        _print_coexist_warning(doc)
        print(f"{comm} (pid {pid}): memory.high released to max")
        return

    nice_val = _flag_val(rest, "--nice", None)
    if nice_val is not None:
        doc = request_or_die({"cmd": "calm", "pid": pid, "starttime": starttime,
                              "action": "nice", "nice": int(nice_val)})
        _print_coexist_warning(doc)
        print(f"{comm} (pid {pid}): nice -> {doc['nice']}")
        return

    high_val = _flag_val(rest, "--high", None)
    if high_val is not None:
        doc = request_or_die({"cmd": "calm", "pid": pid, "starttime": starttime,
                              "action": "high", "size": high_val})
        _print_coexist_warning(doc)
        got = doc.get("memory_high")
        print(f"{comm} (pid {pid}): memory.high -> "
              f"{'max' if got is None else human_bytes(got)}")
        return

    sys.exit("ramstein: calm needs one of --high SIZE | --release | "
             "--nice N | --kill")


def _print_live_triggers(live):
    """Which of do_autocalm_run's own trigger conditions can this kernel/
    config actually satisfy right now? PSI needs CONFIG_PSI; swap-storm
    needs configured swap. Surfaced so arming isn't a leap of faith on a
    machine where one or both are structurally dead (DM #3079/#3083:
    "must see what it thought and why," applied to capability)."""
    psi_live, swap_live = live.get("psi"), live.get("swap_storm")
    print(f"  live triggers: PSI {'live' if psi_live else 'UNAVAILABLE (no CONFIG_PSI on this kernel)'}"
          f", swap-storm {'live' if swap_live else 'UNAVAILABLE (no swap configured)'}")
    if not psi_live and not swap_live:
        print("  ! neither is live — armed, this machine can compute every"
              " cycle but can never actually trigger")


def cmd_autocalm(argv):
    sub = argv[0] if argv else "status"
    rest = argv[1:]

    if sub == "status":
        doc = request_or_die({"cmd": "autocalm", "action": "status"})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        print(f"auto-calm: enabled={doc['enabled']}  armed={doc['armed']}")
        p = doc["policy"]
        steps = "+".join(s for s, on in
                         (("renice", p["step_renice"]), ("squeeze", p["step_squeeze"]))
                         if on) or "(no steps enabled)"
        print(f"  trigger: PSI some > {p['psi_some']:.1f}% or"
              f" full > {p['psi_full']:.1f}%"
              + (" or swap storm" if p["use_swap_storm"] else ""))
        print(f"  steps: {steps}  (nice={p['nice']}, squeeze to"
              f" {p['squeeze_pct']:.0f}% rss, cooldown {p['cooldown_seconds']:.0f}s)")
        if doc.get("live_triggers"):
            _print_live_triggers(doc["live_triggers"])
        if doc.get("last_action_ts"):
            age = human_eta(int(time.time() - doc["last_action_ts"])).lstrip("~") or "0s"
            r = doc["last_result"] or {}
            verb = "acted" if r.get("acted") else ("dry-run" if r.get("dry_run") else "no-op")
            print(f"  last cycle ({age} ago): {verb} — {r.get('trigger') or r.get('reason')}")
        else:
            print("  no cycles run yet")
        return

    if sub == "dry":
        doc = request_or_die({"cmd": "autocalm", "action": "dry"})
        print("auto-calm disarmed — back to dry-run (computes + notifies, never acts)")
        if doc.get("persist_warning"):
            print(f"! {doc['persist_warning']}")
        return

    if sub == "arm":
        yes = "--yes" in rest
        doc = request_or_die({"cmd": "autocalm", "action": "arm", "dry_run": not yes})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        if doc.get("dry_run"):
            print("Arming auto-calm lets ramsteind ACT on its own on a timer —")
            print("renice the top memory grower and/or squeeze its cgroup")
            print("memory.high — without asking you first. It will NEVER kill")
            print("anything: kill stays a human verb with a TTY confirm, forever.")
            print(f"{doc['note']}")
            print("disarm any time with `ramstein autocalm dry`"
                  " (dry-run — add --yes to apply).")
            status = request_or_die({"cmd": "autocalm", "action": "status"})
            if status.get("live_triggers"):
                _print_live_triggers(status["live_triggers"])
            return
        if not doc.get("ok"):
            sys.exit(f"ramstein: autocalm arm failed: {doc.get('error', doc)}")
        print("auto-calm ARMED — it will act for real on its next triggered cycle,")
        print("and stays armed across restarts until you run `ramstein autocalm dry`")
        print("(still needs auto_calm_enabled=true in config, and the"
              " ramstein-autocalm.timer to actually be enabled)")
        if doc.get("persist_warning"):
            print(f"! {doc['persist_warning']}")
        return

    if sub == "run":
        doc = request_or_die({"cmd": "autocalm", "action": "run"})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        if not doc.get("acted") and not doc.get("dry_run"):
            print(f"auto-calm: {doc.get('reason', 'no action')}")
            return
        verb = "acted" if doc.get("acted") else "would act (dry-run)"
        t = doc.get("target") or {}
        steps = ", ".join(s["step"] for s in doc.get("steps", [])) or "none"
        print(f"auto-calm {verb} on {t.get('comm', '?')} (pid {t.get('pid', '?')})"
              f" — {doc.get('trigger')}. steps: {steps}")
        return

    sys.exit("ramstein: autocalm needs one of status | arm | dry | run")


def cmd_oomd(argv):
    """Layer 3's first verb (ruling 41b72476): enroll this session into
    systemd-oomd's swap-kill protection, which Ubuntu ships configured
    for memory pressure but never for swap — the exact scenario ramstein
    exists for. `enroll` writes a drop-in, restarts systemd-oomd (proven
    necessary — a config write alone doesn't make it re-discover units),
    and re-measures with the real detector before ever claiming success."""
    sub = argv[0] if argv else "status"
    rest = argv[1:]

    if sub == "status":
        doc = request_or_die({"cmd": "oomd", "action": "status"})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        print(f"oomd swap-kill protection: "
              f"{'ENROLLED' if doc['enrolled'] else 'not enrolled'}"
              f" (ramstein's own drop-in "
              f"{'present' if doc['ramstein_dropin_present'] else 'absent'})")
        if doc.get("preflight_would_refuse"):
            print(f"  ! enrolling right now would refuse:"
                  f" {doc['preflight_would_refuse']}")
        return

    if sub == "enroll":
        yes = "--yes" in rest
        doc = request_or_die({"cmd": "oomd", "action": "enroll", "dry_run": not yes})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        if doc.get("dry_run"):
            print("Enrolling asks systemd-oomd to SIGKILL a process in your")
            print("session if swap AND memory both stay critically full at")
            print("once — the exact scenario ramstein exists to catch, which")
            print("Ubuntu ships configured for memory pressure but NOT for")
            print("swap. This restarts systemd-oomd (required for it to")
            print(f"notice the change) and writes {doc['would_write']},")
            print(f"which {doc['note']}; undo any time with")
            print("`ramstein oomd disenroll` (dry-run — add --yes to apply).")
            return
        if not doc.get("ok"):
            sys.exit(f"ramstein: oomd enroll failed: {doc.get('error', doc)}")
        print("oomd swap-kill protection ENROLLED and confirmed live"
              " (re-measured, not just written).")
        return

    if sub == "disenroll":
        request_or_die({"cmd": "oomd", "action": "disenroll"})
        print("oomd swap-kill protection removed and confirmed live —"
              " restored to this machine's default (unenrolled unless"
              " something else enrolls it).")
        return

    sys.exit("ramstein: oomd needs one of status | enroll | disenroll")


def cmd_swappiness(argv):
    """Layer 3, verb #2: vm.swappiness. Persisted via a sysctl.d drop-in
    and applied live immediately -- no restart, no daemon to notice a
    config reload. SEGMENT-shaped for the pill (a small named-stance
    set); the CLI takes the raw kernel value (0-200) since it's for
    agents and experts, not the pill's chip labels."""
    sub = argv[0] if argv else "status"
    rest = argv[1:]

    if sub == "status":
        doc = request_or_die({"cmd": "swappiness", "action": "status"})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        present = "present" if doc["ramstein_dropin_present"] else "absent"
        print(f"vm.swappiness: {doc['current']} (ramstein drop-in {present})")
        if doc.get("prior") is not None:
            print(f"  prior value (before ramstein first changed it):"
                  f" {doc['prior']} -- `ramstein swappiness reset` restores it")
        return

    if sub == "set":
        # parse-only here; the daemon owns the real range (0-200) and its
        # error comes back through request_or_die same as any other verb —
        # the CLI doesn't duplicate a range it doesn't enforce
        if not rest or not rest[0].lstrip("-").isdigit():
            sys.exit("ramstein: swappiness set needs an integer value")
        value = int(rest[0])
        yes = "--yes" in rest
        doc = request_or_die({"cmd": "swappiness", "action": "set", "value": value,
                              "dry_run": not yes}, as_json="--json" in rest)
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        if doc.get("dry_run"):
            print(f"vm.swappiness: {doc['current']} -> {doc['proposed']}")
            print(f"  {doc['note']} (dry-run — add --yes to apply)")
            return
        if not doc.get("ok"):
            sys.exit(f"ramstein: swappiness set failed: {doc.get('error', doc)}")
        print(f"vm.swappiness -> {doc['measured']} confirmed live"
              f" (prior value {doc['prior']} ledgered for `swappiness reset`).")
        return

    if sub == "reset":
        doc = request_or_die({"cmd": "swappiness", "action": "reset"})
        if not doc.get("ok"):
            sys.exit(f"ramstein: swappiness reset failed: {doc.get('error', doc)}")
        print(f"vm.swappiness restored to {doc['restored_to']} and confirmed live.")
        return

    sys.exit("ramstein: swappiness needs one of status | set N | reset")


def _swap_size_poll_until_done(timeout_s=120):
    """`set`'s BOUNDED-WAIT half: the daemon already returned `pending`
    immediately (fallocate+mkswap scale with size), so the CLI polls
    status instead of blocking the socket for however long that takes —
    same shape as --kill's post-SIGTERM poll, just with no fixed cap on
    what "a while" means."""
    start = time.time()
    while time.time() - start < timeout_s:
        doc = request_or_die({"cmd": "swap-size", "action": "status"})
        if not doc.get("in_progress"):
            lr = doc.get("last_result")
            if lr and lr.get("ok"):
                print(f"done — {human_bytes(lr['measured'])} active"
                      " (confirmed live, not just written).")
            else:
                print(f"FAILED: {lr.get('error') if lr else 'no result recorded'}")
            return
        time.sleep(1)
    print("still running after 2 minutes — check `ramstein swap-size status` later.")


def cmd_swap_size(argv):
    """Layer 3, verb #3: a standalone, additive swap file (own backing
    file + own systemd .swap unit) -- BOUNDED-WAIT, so `set` reports
    pending immediately and the CLI polls for the real outcome. Never
    touches the machine's own pre-existing swap."""
    sub = argv[0] if argv else "status"
    rest = argv[1:]

    if sub == "status":
        doc = request_or_die({"cmd": "swap-size", "action": "status"})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        active = doc["active_bytes"]
        print(f"swap-size: {human_bytes(active)} active" if active else
              "swap-size: none (ramstein-managed extra swap not enabled)")
        if doc["in_progress"]:
            req = doc.get("requested")
            print(f"  a resize to {human_bytes(req) if req else '?'}"
                  " is in progress...")
        lr = doc.get("last_result")
        if lr and not doc["in_progress"]:
            outcome = "ok" if lr.get("ok") else f"FAILED: {lr.get('error')}"
            print(f"  last change: {outcome}")
        print(f"  disk headroom if left unchanged:"
              f" {human_bytes(doc['disk_headroom_bytes'])}")
        return

    if sub == "set":
        if not rest:
            sys.exit("ramstein: swap-size set needs a size, e.g. 4G")
        size = rest[0]
        yes = "--yes" in rest
        doc = request_or_die({"cmd": "swap-size", "action": "set", "size": size,
                              "dry_run": not yes})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        if doc.get("dry_run"):
            print(f"Creating/resizing a ramstein-managed swap file to {size} —")
            print(f"  {doc['note']}")
            print(f"  disk headroom after: {human_bytes(doc['disk_headroom_after_bytes'])}")
            print("  (dry-run — add --yes to apply)")
            return
        if "error" in doc:
            sys.exit(f"ramstein: swap-size set failed: {doc['error']}")
        print(f"Started — resizing to {size}...")
        _swap_size_poll_until_done()
        return

    if sub == "remove":
        doc = request_or_die({"cmd": "swap-size", "action": "remove"})
        if not doc.get("ok"):
            sys.exit(f"ramstein: swap-size remove failed: {doc.get('error', doc)}")
        print("ramstein-managed swap removed and confirmed off.")
        return

    sys.exit("ramstein: swap-size needs one of status | set SIZE | remove")


def _zram_poll_until_done(timeout_s=60):
    """Same BOUNDED-WAIT shape as swap-size's own poll — zram device
    creation is usually fast, but it goes through the identical
    write-config/daemon-reload/systemctl-start sequence, so it gets the
    identical pending+poll treatment rather than assuming "usually fast"
    means "always fast enough to block the socket on"."""
    start = time.time()
    while time.time() - start < timeout_s:
        doc = request_or_die({"cmd": "zram", "action": "status"})
        if not doc.get("in_progress"):
            lr = doc.get("last_result")
            if lr and lr.get("ok"):
                print(f"done — {human_bytes(lr['measured'])} active"
                      " (confirmed live, not just written).")
            else:
                print(f"FAILED: {lr.get('error') if lr else 'no result recorded'}")
            return
        time.sleep(1)
    print("still running after a minute — check `ramstein zram status` later.")


def cmd_zram(argv):
    """Layer 3, verb #4: compressed RAM-backed swap via systemd-zram-
    generator. BOUNDED-WAIT like swap-size -- enable/disable report
    pending immediately, the CLI polls for the real outcome."""
    sub = argv[0] if argv else "status"
    rest = argv[1:]

    if sub == "status":
        doc = request_or_die({"cmd": "zram", "action": "status"})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        if not doc["generator_present"]:
            print("zram: systemd-zram-generator is not installed"
                  " (apt install systemd-zram-generator)")
            return
        active = doc["active_bytes"]
        print(f"zram: {human_bytes(active)} active" if active else
              "zram: none (device not active)")
        print(f"  config: {'enabled' if doc['config_enabled'] else 'disabled'}")
        if doc["in_progress"]:
            print("  a change is in progress...")
        lr = doc.get("last_result")
        if lr and not doc["in_progress"]:
            outcome = "ok" if lr.get("ok") else f"FAILED: {lr.get('error')}"
            print(f"  last change: {outcome}")
        return

    if sub == "enable":
        yes = "--yes" in rest
        doc = request_or_die({"cmd": "zram", "action": "enable", "dry_run": not yes})
        if "--json" in rest:
            print(json.dumps(doc, indent=2))
            return
        if doc.get("dry_run"):
            print(f"Enabling compressed RAM-backed swap: {doc.get('would_configure', '')}")
            print(f"  {doc['note']}")
            print("  (dry-run — add --yes to apply)")
            return
        if "error" in doc:
            sys.exit(f"ramstein: zram enable failed: {doc['error']}")
        print("Started — enabling zram...")
        _zram_poll_until_done()
        return

    if sub == "disable":
        doc = request_or_die({"cmd": "zram", "action": "disable"})
        if "error" in doc:
            sys.exit(f"ramstein: zram disable failed: {doc['error']}")
        print("Started — disabling zram...")
        _zram_poll_until_done()
        return

    sys.exit("ramstein: zram needs one of status | enable | disable")


def cmd_update(argv):
    """Delegate straight to ramstein-update (execvp — its exit code becomes
    ours). `ramstein update --check --json` is the pill's UpdateSurface
    checking for a newer release without needing pkexec; a bare `ramstein
    update` is the manual-install consent tier."""
    binary = "ramstein-update"
    path = binary  # last resort: PATH lookup
    for cand in (f"/usr/bin/{binary}", f"/usr/local/bin/{binary}"):
        if os.path.exists(cand):
            path = cand
            break
    try:
        os.execvp(path, [binary, *argv])
    except OSError as e:
        sys.exit(f"cannot run {binary}: {e}")


USAGE = """\
ramstein — verb CLI over the ramsteind control socket

usage: ramstein [verb] [args...]

verbs:
  status                          available memory, PSI, burn rate, ETA-to-OOM (default)
  top [--swap] [--limit N]        biggest RSS (or --swap) consumers
  swap [--limit N]                processes parked in swap
  blame [--since T] [--limit N]   RSS movers since T (30s / 10m / 2h / 1d / YYYY-MM-DD)
  zombies                         unreaped zombie processes, grouped by parent
  oom                             who dies first, by oom_score
  advise                          rule-based notices (pressure/growth/swap/zombies/...)
  calm <pid|comm> --high SIZE|--release|--nice N|--kill
                                   renice, squeeze, release, or kill a process
  autocalm status|arm|dry|run     unattended calm: arm/disarm, or run one cycle
  oomd status|enroll|disenroll    layer-3: enroll this session in systemd-oomd's swap-kill protection
  swappiness status|set N|reset   layer-3: vm.swappiness, persisted + applied live (0-200)
  swap-size status|set SIZE|remove  layer-3: standalone additive swap file, e.g. 4G
  zram status|enable|disable      layer-3: compressed RAM-backed swap (systemd-zram-generator)
  update [--check]                check for / delegate to ramstein-update

--json applies to any read verb for machine-readable output.
man ramstein / man 8 ramsteind for the full reference.
"""


def main():
    argv = sys.argv[1:]
    # Every unrecognized flag used to fall through to the default verb
    # (status) with a live socket call — the exact SUTRA_CHECK_ARGS hazard
    # class (sutra.mk 0.11.1's own fix, this same session): `ramstein --help`
    # silently paged the live daemon instead of printing usage. --json alone
    # is the one legitimate bare-flag shorthand (`ramstein --json` ==
    # `ramstein status --json`, cmd_status's only recognized flag) and is
    # allow-listed explicitly rather than accepting any dash-token as "must
    # be flags for status."
    if argv and argv[0] in ("-h", "--help"):
        print(USAGE, end="")
        return
    if argv and argv[0] == "--json":
        cmd_status(argv)
        return
    if argv and argv[0].startswith("-"):
        sys.exit(f"ramstein: unknown option '{argv[0]}' (try --help)")
    verb = argv[0] if argv else "status"
    rest = argv[1:] if argv else []
    verbs = {"status": cmd_status, "top": cmd_top, "blame": cmd_blame,
             "swap": cmd_swap, "zombies": cmd_zombies, "oom": cmd_oom,
             "advise": cmd_advise, "calm": cmd_calm, "autocalm": cmd_autocalm,
             "oomd": cmd_oomd, "swappiness": cmd_swappiness,
             "swap-size": cmd_swap_size, "zram": cmd_zram,
             "update": cmd_update}
    if verb in verbs:
        verbs[verb](rest)
    elif verb in PLANNED:
        sys.exit(f"ramstein {verb}: not yet — {PLANNED[verb]}")
    else:
        known = ", ".join(list(verbs) + list(PLANNED))
        sys.exit(f"ramstein: unknown verb '{verb}' (verbs: {known})")


if __name__ == "__main__":
    main()
