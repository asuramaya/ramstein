#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 asuramaya and RAMstein contributors
"""ramstein-update — is a newer RAMstein release out? Install it, on consent.

Thin wrapper over the vendored sutra_update.py (UNIFY.md Wave A #1, the
family's shared update spine — one grammar, one trust chain, one
install-path detection, three consent tiers). This file supplies only
what's RAMstein-specific: the repo slug, the installed-version lookup
(dpkg first — the authoritative source across a .deb upgrade — VERSION
file fallback for a source install), and where the signing anchor lives.

  ramstein-update --check [--json]   notify tier (default): report only
  ramstein-update                    manual install tier (explicit consent)
  ramstein-update --auto             timer tier — inert here, since
                                      RAMstein has no auto_update config
                                      toggle (installs stay notify+click,
                                      never unattended); the daily timer
                                      only ever passes --check.

This is deliberately a SEPARATE program from the daemon: ramsteind never
touches the network at all, so the one component that reaches the
internet is this small, unprivileged-when-checking updater — never the
privileged poller.
"""
import os
import subprocess
import sys

# --- sutra bootstrap (sutra 0.8.0; see BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "ramstein"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra_update  # noqa: E402

REPO_SLUG = "asuramaya/RAMstein"
PILL = "ramstein"
# This file lives at src/bin/ramstein-update, two levels under the repo
# root, so reaching root needs three dirname calls, not two — a level got
# added when bin/ moved under src/ (REPO-STANDARD.md's tree pass).
_SRC_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
# .deb installs share/ under /usr; install.sh's source install defaults
# PREFIX to /usr/local — both are real, so both are checked before falling
# back to the repo-relative path for a dev checkout that's never been
# installed at all.
VERSION_CANDIDATES = (
    "/usr/share/ramstein/VERSION",
    "/usr/local/share/ramstein/VERSION",
    os.path.join(_SRC_DIR, "packaging", "VERSION"),
)
ANCHOR_CANDIDATES = (
    "/usr/share/ramstein/allowed_signers",
    "/usr/local/share/ramstein/allowed_signers",
    os.path.join(_SRC_DIR, "packaging", "release-signing", "allowed_signers"),
)


def deb_version():
    """The dpkg-registered package version, or None if not a .deb install."""
    try:
        out = subprocess.check_output(
            ["dpkg-query", "-W", "-f=${Version}", PILL],
            stderr=subprocess.DEVNULL)
        return out.decode().strip() or None
    except Exception:
        return None


def installed_version():
    """Best-effort version for display/--check: dpkg first (authoritative
    across a .deb upgrade), else whichever VERSION file a source install or
    dev checkout wrote."""
    v = deb_version()
    if v:
        return v
    for path in VERSION_CANDIDATES:
        try:
            with open(path) as f:
                v = f.read().strip()
        except OSError:
            continue
        if v:
            return v
    return "unknown"


if __name__ == "__main__":
    sys.exit(sutra_update.main(
        pill=PILL, slug=REPO_SLUG, installed_version=installed_version(),
        anchor_candidates=list(ANCHOR_CANDIDATES), auto_enabled=False))
