[Unit]
Description=ramstein memory daemon — owns the truth about bytes alive
Documentation=https://github.com/asuramaya/ramstein

[Service]
Type=simple
ExecStart=/usr/local/bin/ramsteind
Restart=on-failure
RestartSec=5

RuntimeDirectory=ramstein
RuntimeDirectoryMode=0755
StateDirectory=ramstein
NoNewPrivileges=yes
ProtectSystem=strict
# /sys/fs/cgroup carries calm --high's memory.high write — ProtectKernel
# Tunables below makes all of /sys read-only, so it needs the same
# allow-list carve-out ReadWritePaths already does for ProtectSystem=strict
# (nest a writable path inside a read-only one). Verified against a LIVE
# calm --high, not just fixtures: see docs/ARCHITECTURE.md's security model.
# /etc/ramstein carries `autocalm arm`/`dry`'s auto_calm_armed persistence
# (DM #3074/#3079/#3080, _persist_auto_calm_armed) — reading config.json
# already worked under ProtectSystem=strict (read-only still permits
# reads), but writing the operator's arm/dry choice back needs the same
# carve-out. Verified under the REAL unit, not assumed from the directive
# list: armed a live daemon running under this exact hardened unit inside
# a real systemd container, confirmed the write landed on disk, restarted
# the unit for real, and confirmed `autocalm status` still read armed=true
# with no re-arm — same for the dry/false direction.
# /proc/sys/vm/swappiness carries the swappiness verb's live apply, and
# /etc/sysctl.d its persistent drop-in (90-ramstein-swappiness.conf) —
# same ProtectKernelTunables/ProtectSystem carve-out shape as /sys/fs/
# cgroup and /etc/ramstein above, found the same way: read the unit's own
# hardening directives before assuming a new verb's write path is covered,
# rather than discover it live when the verb is first called for real.
#
# /etc/systemd/system/user@.service.d WAS MISSING despite oomd enroll
# already shipping and being described as "verified live" — that claim
# was about the swap-enrollment MECHANISM (source-confirmed, oomctl
# re-measured), never about this write path specifically. Found while
# checking swap-size's own upcoming ReadWritePaths needs, by testing the
# ALREADY-SHIPPED oomd enroll against a from-scratch container install of
# this exact unit rather than assuming past testing covered it: enroll
# failed with "Read-only file system" on the drop-in write, caught
# cleanly (no crash, an honest {"ok": false} — the try/except around the
# write did its job), but silently wrong on every fresh install of this
# hardening pass until now. Scoped to the one directory the verb writes,
# not all of /etc/systemd/system, for the same reason every other entry
# here is a single path rather than its whole parent.
#
# /etc/systemd/zram-generator.conf — same gap, third instance, found the
# same way this time on real hardware rather than in a container: zram
# enable() correctly stopped a pre-existing device first (see
# _zram_apply's own docstring), then failed writing this file with
# "Read-only file system" before ever reaching daemon-reload/start. A
# single FILE, not a directory, and it may not exist at all depending on
# the installed systemd-zram-generator version (some ship a default
# conffile here, some rely purely on compiled-in defaults) — install.sh/
# postinst touch it into existence for the same reason they mkdir
# user@.service.d: ReadWritePaths needs its target to already exist at
# unit start, or the whole daemon fails to start, not just this write.
ReadWritePaths=/run/ramstein /var/lib/ramstein /sys/fs/cgroup /etc/ramstein \
                /proc/sys/vm/swappiness /etc/sysctl.d \
                /etc/systemd/system/user@.service.d \
                /etc/systemd/zram-generator.conf
# Everything M0 reads lives under /proc — nothing in $HOME matters to any
# verb through M3 (calm/kill touch /proc + /sys/fs/cgroup, never $HOME).
ProtectHome=yes

# --- M4 hardening pass ---
# Each retained capability maps to something the code actually does as
# root; nothing here is "just in case."
#   CAP_SYS_PTRACE — the M2 sampler + M3 oom/zombies scan EVERY process's
#     /proc/<pid>/{status,stat,cgroup,oom_score}, not just owner_uid's own;
#     reading another user's process internals needs this (see
#     docs/ARCHITECTURE.md's data-sources section).
#   CAP_SYS_NICE — calm --nice renices a target process not owned by the
#     daemon's own (root) identity in the DAC sense that setpriority checks.
#   CAP_KILL — calm --kill signals a target process; sending a signal to a
#     process of a different uid needs this bit even as uid 0 once the
#     bounding set is restricted.
#   CAP_DAC_OVERRIDE — writing a target's cgroup memory.high regardless of
#     its specific ownership/mode (cgroup delegation schemes vary).
#   CAP_CHOWN — write_status() and the control socket setup chown
#     status.json/control.sock to owner_uid whenever running as root.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_SYS_NICE CAP_KILL CAP_DAC_OVERRIDE CAP_CHOWN
SystemCallFilter=@system-service
ProtectKernelTunables=yes
ProtectClock=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
