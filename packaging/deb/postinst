#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# ramstein postinst — shares the config-seed logic with install.sh via
# /usr/share/ramstein/scripts/seed-owner-uid.py (packaged from packaging/ in
# the source tree) so the two installers can't drift apart.
set -e

CONFIG=/etc/ramstein/config.json
SEED=/usr/share/ramstein/scripts/seed-owner-uid.py

case "$1" in
  configure)
    OLD_VERSION="$2"
    if [ -z "$OLD_VERSION" ]; then
      # Fresh install only: dpkg just unpacked the package's default
      # config.json as a conffile. An upgrade means dpkg already decided
      # whether the user's edited copy survives — never re-stamp then.
      OWNER_UID="${SUDO_UID:-1000}"
      python3 "$SEED" "$CONFIG" "$CONFIG" "$OWNER_UID"
    fi
    # ReadWritePaths carves out user@.service.d for oomd enroll's drop-in,
    # but needs the target to already EXIST at unit start (it doesn't
    # create anything, unlike StateDirectory=/RuntimeDirectory=) -- a
    # missing target fails the WHOLE unit (226/NAMESPACE), not just the
    # write. install.sh carries the same step; see its comment there.
    mkdir -p /etc/systemd/system/user@.service.d
    # Same reason, third time: zram-generator.conf is a single FILE (not
    # a directory) that may not exist depending on the installed
    # systemd-zram-generator version -- touch, never overwrite, so a
    # package-shipped default (when one exists) survives untouched.
    [ -e /etc/systemd/zram-generator.conf ] || touch /etc/systemd/zram-generator.conf
    systemctl daemon-reload >/dev/null 2>&1 || true
    if ! systemctl enable ramsteind.service >/dev/null 2>&1; then
      echo "ramstein postinst: WARNING — systemctl enable ramsteind.service" \
           "failed; the daemon will not start on boot. Run it by hand:" \
           "systemctl enable ramsteind.service" >&2
    fi
    if systemctl is-active --quiet ramsteind.service 2>/dev/null; then
      systemctl restart ramsteind.service || true
    else
      systemctl start ramsteind.service || true
    fi
    # THE HONESTY FIX (thread d92d86f2, alfred's DM 4577 — same defect as
    # `oomd disenroll` printing "confirmed live" without checking, bigger
    # blast radius: dpkg's own "ramstein set up successfully" line IS the
    # operator's evidence the daemon is running, and `|| true` above meant
    # a start/restart failure produced that exact false confidence. NOT a
    # hard failure (`set -e` stays off this check on purpose) — Debian
    # convention is a postinst should not abort dpkg's own transaction, and
    # possibly other packages' configuration with it, over a service that
    # can be started by hand afterward. The fix is SAYING it, not blocking
    # it — the same distinction the pill's own oomd caption makes between
    # a confirmed negative and an unconfirmed one.
    if ! systemctl is-active --quiet ramsteind.service 2>/dev/null; then
      echo "ramstein postinst: WARNING — ramsteind.service did not start." \
           "The package installed but the daemon is not running. Check:" \
           "systemctl status ramsteind.service" >&2
    fi
    ;;
esac

exit 0
